      {
        "operatorID": "filter_known_causes_jan_mar",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_wildfires) -> pd.DataFrame:\n    df = load_wildfires.copy()\n    df['start_date_parsed'] = pd.to_datetime(df['start_date'], errors='coerce')\n    df['month'] = df['start_date_parsed'].dt.month\n    # Known causes: L (lightning) and H (human); exclude U (unknown) and N\n    known = df[df['cause'].isin(['L', 'H'])]\n    jan_mar = known[known['month'].isin([1, 2, 3])]\n    return jan_mar[['region', 'cause', 'month']]\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
