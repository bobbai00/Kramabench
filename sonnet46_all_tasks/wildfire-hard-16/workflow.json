      {
        "operatorID": "chi_square_test",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\nfrom scipy.stats import chi2_contingency\n\ndef process(filter_known_causes_jan_mar):\n    contingency = pd.crosstab(filter_known_causes_jan_mar['region'], filter_known_causes_jan_mar['cause'])\n    chi2, p, dof, expected = chi2_contingency(contingency)\n    result = pd.DataFrame({\n        'chi2_statistic': [round(chi2, 3)],\n        'p_value': [round(p, 3)],\n        'degrees_of_freedom': [dof]\n    })\n    return result\n"
        },
