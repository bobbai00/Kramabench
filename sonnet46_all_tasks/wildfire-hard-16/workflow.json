        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Filter wildfire data to: (1) known causes only (cause != 'U' and cause != 'N', keeping 'L' and 'H'), and (2) fires starting in January, February, or March (months 1-3). Parses start_date to extract month.",
        "dynamicInputPorts": true,
