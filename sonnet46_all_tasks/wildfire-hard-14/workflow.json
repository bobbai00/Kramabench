        "operatorProperties": {
          "code": "\ndef process(aqi_by_state, wildfire_data):\n    merged = aqi_by_state.merge(wildfire_data[['State', 'Total Acres Burned']], on='State', how='inner')\n    corr = merged['unsafe_proportion'].corr(merged['Total Acres Burned'])\n    return pd.DataFrame({'correlation': [round(corr, 2)]})\n"
