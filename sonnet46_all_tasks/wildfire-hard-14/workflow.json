        "operatorID": "aqi_by_state",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(aqi_data) -> pd.DataFrame:\n    cols = ['State', 'Days with AQI', 'Good Days', 'Moderate Days',\n            'Unhealthy for Sensitive Groups Days', 'Unhealthy Days',\n            'Very Unhealthy Days', 'Hazardous Days']\n    agg = aqi_data[cols].groupby('State').sum().reset_index()\n    # \"Generally unsafe\" = Unhealthy for Sensitive Groups + Unhealthy + Very Unhealthy + Hazardous\n    unsafe_cols = ['Unhealthy for Sensitive Groups Days', 'Unhealthy Days',\n                   'Very Unhealthy Days', 'Hazardous Days']\n    agg['unsafe_days'] = agg[unsafe_cols].sum(axis=1)\n    agg['unsafe_proportion'] = agg['unsafe_days'] / agg['Days with AQI']\n    return agg[['State', 'Days with AQI', 'unsafe_days', 'unsafe_proportion']]\n"
        },
        "inputPorts": [
