        "operatorProperties": {
          "code": "def process(aggregate_by_state, load_state_abbrev):\n    merged = aggregate_by_state.merge(load_state_abbrev, left_on='state', right_on='abbreviation', how='left')\n    merged = merged.sort_values('total_prim_threatened', ascending=False)\n    return merged[['state', 'state_name', 'total_prim_threatened']].head(3).reset_index(drop=True)\n"
