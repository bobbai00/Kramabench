      {
        "operatorID": "aggregate_by_state",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(filter_2005_2010):\n    # Sum prim_threatened_aggregate (primary residences at risk) by state\n    # Do NOT drop rows with missing values - use fillna(0) only for the aggregation column if needed\n    # Actually, keep NaN as NaN in sum (skipna=True is default, which is correct)\n    agg = filter_2005_2010.groupby('state', dropna=False)['prim_threatened_aggregate'].sum().reset_index()\n    agg.columns = ['state', 'total_prim_threatened']\n    agg = agg.sort_values('total_prim_threatened', ascending=False)\n    return agg\n"
        },
