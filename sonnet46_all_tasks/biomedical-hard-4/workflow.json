      {
        "operatorID": "get_grades",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_mmc1, load_mmc4_alt_splice):\n    # Find the row with the target peptide\n    peptide_row = load_mmc4_alt_splice[load_mmc4_alt_splice['Peptide'] == 'HPKPEVLGSSADGALLVSLDGLR']\n    samples_str = peptide_row['Samples_With_Peptide'].iloc[0]\n    samples = [s.strip() for s in samples_str.split(',')]\n    \n    # mmc1 has idx column - map sample IDs to histological grades\n    # Sample IDs in mmc4 look like S028, S034, S040\n    # In mmc1, idx looks like S001 etc.\n    result = load_mmc1[load_mmc1['idx'].isin(samples)][['idx', 'Proteomics_Participant_ID', 'Histologic_Grade_FIGO']]\n    return result\n"
        },
