      {
        "operatorID": "get_histological_grades",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_alt_splice, load_mmc1):\n    # Find the peptide of interest\n    peptide_row = load_alt_splice[load_alt_splice['Peptide'] == 'HPKPEVLGSSADGALLVSLDGLR']\n    samples_str = peptide_row['Samples_With_Peptide'].values[0]\n    samples = [s.strip() for s in samples_str.split(',')]\n    \n    # Map sample IDs to idx in mmc1 (idx column looks like S001, S028, etc.)\n    result = load_mmc1[load_mmc1['idx'].isin(samples)][['idx', 'Proteomics_Participant_ID', 'Histologic_Grade_FIGO']]\n    return result\n"
        },
