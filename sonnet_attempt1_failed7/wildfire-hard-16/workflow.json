      {
        "operatorID": "filter_jfm_known",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_data) -> pd.DataFrame:\n    df = load_data.copy()\n    df['start_date_parsed'] = pd.to_datetime(df['start_date'], errors='coerce')\n    df['month'] = df['start_date_parsed'].dt.month\n    # Known causes: exclude 'U' (unknown) and 'N' (not applicable / natural unspecified)\n    known = df[df['cause'].isin(['L', 'H'])]\n    # Filter to Jan, Feb, Mar\n    jfm = known[known['month'].isin([1, 2, 3])]\n    return jfm[['region', 'cause', 'month']]\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
            "isDynamicPort": false,
            "dependencies": []
          }
        ],
