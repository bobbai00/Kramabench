          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Filter wildfire data to: (1) fires with known causes (cause != 'U' and cause != 'N'), and (2) fires starting in January, February, or March. Parse start_date to extract month.",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "chi_square_test",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(filter_jfm_known):\n    from scipy.stats import chi2_contingency\n    contingency = pd.crosstab(filter_jfm_known['region'], filter_jfm_known['cause'])\n    chi2, p, dof, expected = chi2_contingency(contingency)\n    result = pd.DataFrame({\n        'metric': ['chi2_statistic', 'p_value', 'degrees_of_freedom'],\n        'value': [round(chi2, 3), round(p, 3), dof]\n    })\n    return result\n"
        },
        "inputPorts": [
