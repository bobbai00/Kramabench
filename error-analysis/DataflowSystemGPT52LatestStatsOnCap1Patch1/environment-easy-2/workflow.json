      {
        "operatorID": "freshBeachExceedanceByYear",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(\n    waterBodyTesting2002,\n    waterBodyTesting2003,\n    waterBodyTesting2004,\n    waterBodyTesting2005,\n    waterBodyTesting2006,\n    waterBodyTesting2007,\n    waterBodyTesting2008,\n    waterBodyTesting2009,\n    waterBodyTesting2010,\n    waterBodyTesting2011,\n    waterBodyTesting2012,\n    waterBodyTesting2013,\n    waterBodyTesting2014,\n    waterBodyTesting2015,\n    waterBodyTesting2016,\n    waterBodyTesting2017,\n    waterBodyTesting2018,\n    waterBodyTesting2019,\n    waterBodyTesting2020,\n    waterBodyTesting2021,\n    waterBodyTesting2022,\n    waterBodyTesting2023,\n):\n    import pandas as pd\n\n    dfs = [\n        waterBodyTesting2002,\n        waterBodyTesting2003,\n        waterBodyTesting2004,\n        waterBodyTesting2005,\n        waterBodyTesting2006,\n        waterBodyTesting2007,\n        waterBodyTesting2008,\n        waterBodyTesting2009,\n        waterBodyTesting2010,\n        waterBodyTesting2011,\n        waterBodyTesting2012,\n        waterBodyTesting2013,\n        waterBodyTesting2014,\n        waterBodyTesting2015,\n        waterBodyTesting2016,\n        waterBodyTesting2017,\n        waterBodyTesting2018,\n        waterBodyTesting2019,\n        waterBodyTesting2020,\n        waterBodyTesting2021,\n        waterBodyTesting2022,\n        waterBodyTesting2023,\n    ]\n\n    df = pd.concat(dfs, ignore_index=True)\n\n    # Freshwater beaches only\n    df = df[df[\"Beach Type Description\"].astype(str).str.strip().str.lower().eq(\"fresh\")].copy()\n\n    # Normalize Violation to yes/no; treat any other/unexpected value as missing\n    viol = df[\"Violation\"].astype(str).str.strip().str.lower()\n    df[\"violationNorm\"] = viol.where(viol.isin([\"yes\", \"no\"]))\n\n    # Exceedance rate: fraction of samples with Violation == 'yes' among non-missing violation\n    usable = df[df[\"violationNorm\"].notna()].copy()\n    usable[\"isExceed\"] = usable[\"violationNorm\"].eq(\"yes\").astype(int)\n\n    byYear = (\n        usable.groupby(\"Year\")\n        .agg(totalSamples=(\"isExceed\", \"size\"), exceedSamples=(\"isExceed\", \"sum\"))\n        .reset_index()\n    )\n    byYear[\"exceedRate\"] = byYear[\"exceedSamples\"] / byYear[\"totalSamples\"]\n\n    # Overall average exceedance rate across years (unweighted mean of annual rates)\n    avgRate = byYear[\"exceedRate\"].mean()\n    byYear[\"avgRate\"] = avgRate\n\n    # Compare rounded-to-2dp rates as requested\n    byYear[\"exceedRate2dp\"] = byYear[\"exceedRate\"].round(2)\n    byYear[\"avgRate2dp\"] = round(float(avgRate), 2)\n    byYear[\"aboveAvg\"] = byYear[\"exceedRate2dp\"] > byYear[\"avgRate2dp\"]\n\n    return byYear.sort_values(\"Year\")\n"
        },
