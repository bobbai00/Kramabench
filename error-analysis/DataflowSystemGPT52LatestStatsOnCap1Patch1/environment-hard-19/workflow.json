      {
        "operatorID": "summerRainDiff",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(monthlyBoston, monthlyChatham) -> pd.DataFrame:\n    import pandas as pd\n    import numpy as np\n\n    def prep(df: pd.DataFrame, site: str) -> pd.DataFrame:\n        d = df.copy()\n        # drop summary rows like 'Max', 'Min' if present in Year\n        d['Year_num'] = pd.to_numeric(d['Year'], errors='coerce')\n        d = d[d['Year_num'].notna()].copy()\n        d['Year'] = d['Year_num'].astype(int)\n\n        months = ['Jun', 'Jul', 'Aug']\n        out = d[['Year'] + months].copy()\n        # Convert 'M' and other non-numeric to NaN\n        for m in months:\n            out[m] = pd.to_numeric(out[m].replace({'M': np.nan, 'T': np.nan, '': np.nan}), errors='coerce')\n\n        # Impute missing values with median of that month across non-missing years\n        for m in months:\n            med = out[m].median(skipna=True)\n            out[m] = out[m].fillna(med)\n\n        out['site'] = site\n        out['summerTotal'] = out[months].sum(axis=1)\n        return out[['Year', 'site', 'summerTotal']]\n\n    b = prep(monthlyBoston, 'Boston')\n    c = prep(monthlyChatham, 'Chatham')\n\n    both = pd.concat([b, c], ignore_index=True)\n    # Sum Boston+Chatham summer rainfall per year\n    yearly = both.groupby('Year', as_index=False)['summerTotal'].sum().sort_values('Year')\n    yearly['prevSummerTotal'] = yearly['summerTotal'].shift(1)\n    yearly['diffFromPrev'] = yearly['summerTotal'] - yearly['prevSummerTotal']\n\n    valid = yearly[yearly['diffFromPrev'].notna()].copy()\n    max_row = valid.loc[valid['diffFromPrev'].idxmax()]\n\n    return pd.DataFrame([{\n        'yearMaxRainDiff': int(max_row['Year']),\n        'maxRainDiff': float(max_row['diffFromPrev']),\n        'summerTotal': float(max_row['summerTotal']),\n        'prevSummerTotal': float(max_row['prevSummerTotal'])\n    }])\n"
        },
