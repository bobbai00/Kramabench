      },
      {
        "operatorID": "marineExceedanceDiff",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(waterBody2002, waterBody2003, waterBody2004, waterBody2005, waterBody2006, waterBody2007, waterBody2008, waterBody2009, waterBody2010, waterBody2011, waterBody2012, waterBody2013, waterBody2014, waterBody2015, waterBody2016, waterBody2017, waterBody2018, waterBody2019, waterBody2020, waterBody2021, waterBody2022, waterBody2023) -> pd.DataFrame:\n    import pandas as pd\n\n    df = pd.concat([\n        waterBody2002, waterBody2003, waterBody2004, waterBody2005, waterBody2006,\n        waterBody2007, waterBody2008, waterBody2009, waterBody2010, waterBody2011,\n        waterBody2012, waterBody2013, waterBody2014, waterBody2015, waterBody2016,\n        waterBody2017, waterBody2018, waterBody2019, waterBody2020, waterBody2021,\n        waterBody2022, waterBody2023\n    ], ignore_index=True)\n\n    # Marine only\n    m = df[df['Beach Type Description'].astype(str).str.strip().str.lower() == 'marine'].copy()\n\n    # Define exceedance as Violation == yes (case-insensitive)\n    viol = m['Violation'].astype(str).str.strip().str.lower()\n    m['isExceed'] = viol.eq('yes')\n\n    # Avg exceedance rate per year\n    yr = pd.to_numeric(m['Year'], errors='coerce')\n    m = m[yr.notna()].copy()\n    m['Year'] = yr.astype(int)\n\n    rates = (\n        m.groupby('Year', as_index=False)\n         .agg(n=('isExceed', 'size'), exceedRate=('isExceed', 'mean'))\n         .sort_values('Year')\n    )\n    rates['prevExceedRate'] = rates['exceedRate'].shift(1)\n    rates['diffFromPrev'] = rates['exceedRate'] - rates['prevExceedRate']\n\n    # Identify year with max diff (ignore first year with NaN diff)\n    valid = rates[rates['diffFromPrev'].notna()].copy()\n    max_row = valid.loc[valid['diffFromPrev'].idxmax()]\n\n    return pd.DataFrame([{\n        'yearMaxExceedDiff': int(max_row['Year']),\n        'maxExceedDiff': float(max_row['diffFromPrev']),\n        'exceedRate': float(max_row['exceedRate']),\n        'prevExceedRate': float(max_row['prevExceedRate'])\n    }])\n"
        },
        "inputPorts": [
