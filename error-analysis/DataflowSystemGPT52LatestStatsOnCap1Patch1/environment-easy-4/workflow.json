      {
        "operatorID": "wollastonMatchesPreview",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(water2019, water2020, water2021, water2022, water2023) -> pd.DataFrame:\n    import pandas as pd\n\n    df = pd.concat([water2019, water2020, water2021, water2022, water2023], ignore_index=True)\n\n    # Normalize\n    community = df['Community'].astype(str).str.strip()\n    beach = df['Beach Name'].astype(str).str.strip()\n\n    # Focus Quincy only, then inspect beach names that look relevant\n    quincy = df[community.str.contains('quincy', case=False, na=False)].copy()\n    quincy['beachNameNorm'] = quincy['Beach Name'].astype(str).str.strip()\n\n    # Grab any rows mentioning 'wollaston' OR 'quincy' in beach name (to catch variants)\n    cand = quincy[quincy['beachNameNorm'].str.contains('wollaston|wollaston beach|wollastonbeach|wollaston-b', case=False, na=False, regex=True)].copy()\n\n    # If none found, fallback to show the top beach names in Quincy to find the right string\n    if len(cand) == 0:\n        out = (quincy.groupby('beachNameNorm')\n                     .size()\n                     .reset_index(name='n')\n                     .sort_values('n', ascending=False)\n                     .head(50))\n        out.insert(0, 'note', 'No wollaston-like beach names found; showing top 50 Quincy beach names')\n        return out\n\n    out = cand[['Year', 'Sample Date', 'Community', 'Beach Name', 'Violation', 'Organism', 'Indicator Level']].head(200)\n    return out"
        },
