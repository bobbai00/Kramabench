      {
        "operatorID": "wollastonPercent",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(water2019, water2020, water2021, water2022, water2023) -> pd.DataFrame:\n    import pandas as pd\n\n    df = pd.concat([water2019, water2020, water2021, water2022, water2023], ignore_index=True)\n\n    # Filter Quincy + Wollaston Beach (all known monitoring points)\n    community = df['Community'].astype(str).str.strip()\n    beach = df['Beach Name'].astype(str).str.strip()\n\n    mask = community.str.casefold().eq('quincy') & beach.str.contains('wollaston', case=False, na=False)\n    sub = df.loc[mask, ['Year', 'Sample Date', 'Community', 'Beach Name', 'Violation']].copy()\n\n    # Normalize violation; swimming standards met when Violation indicates NO\n    viol = sub['Violation'].astype(str).str.strip().str.casefold()\n    meets = viol.eq('no')\n\n    total = int(len(sub))\n    meets_n = int(meets.sum())\n\n    # Guard divide-by-zero; but we expect data to exist\n    percent = int(round(100 * (meets_n / total), 0)) if total > 0 else 0\n\n    return pd.DataFrame([{\n        'totalSamples': total,\n        'meetsSamples': meets_n,\n        'percentMeets': percent\n    }])\n"
        },
