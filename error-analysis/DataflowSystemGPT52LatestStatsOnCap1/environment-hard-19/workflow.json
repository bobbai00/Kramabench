      {
        "operatorID": "marineExceedanceYoY",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(loadBeach2002, loadBeach2003, loadBeach2004, loadBeach2005, loadBeach2006, loadBeach2007, loadBeach2008, loadBeach2009, loadBeach2010, loadBeach2011, loadBeach2012, loadBeach2013, loadBeach2014, loadBeach2015, loadBeach2016, loadBeach2017, loadBeach2018, loadBeach2019, loadBeach2020, loadBeach2021, loadBeach2022, loadBeach2023) -> pd.DataFrame:\n    import pandas as pd\n\n    dfs = [\n        loadBeach2002, loadBeach2003, loadBeach2004, loadBeach2005, loadBeach2006,\n        loadBeach2007, loadBeach2008, loadBeach2009, loadBeach2010, loadBeach2011,\n        loadBeach2012, loadBeach2013, loadBeach2014, loadBeach2015, loadBeach2016,\n        loadBeach2017, loadBeach2018, loadBeach2019, loadBeach2020, loadBeach2021,\n        loadBeach2022, loadBeach2023,\n    ]\n    all_df = pd.concat(dfs, ignore_index=True)\n\n    # Keep marine beaches only\n    marine = all_df[all_df['Beach Type Description'].astype(str).str.strip().str.lower() == 'marine'].copy()\n\n    # Standardize violation to boolean\n    v = marine['Violation'].astype(str).str.strip().str.lower()\n    marine['isExceed'] = v.isin(['yes', 'y', 'true', '1'])\n\n    marine['Year'] = pd.to_numeric(marine['Year'], errors='coerce')\n\n    annual = (\n        marine.groupby('Year', as_index=False)\n        .agg(totalSamples=('isExceed', 'size'), exceedSamples=('isExceed', 'sum'))\n    )\n    annual['avgExceedanceRate'] = annual['exceedSamples'] / annual['totalSamples']\n    annual = annual.sort_values('Year')\n    annual['prevYear'] = annual['Year'].shift(1)\n    annual['prevRate'] = annual['avgExceedanceRate'].shift(1)\n    annual['rateDiff'] = annual['avgExceedanceRate'] - annual['prevRate']\n\n    # For the question: year with the highest average exceedance rate difference vs previous year.\n    yoy = annual.dropna(subset=['rateDiff']).copy()\n    max_row = yoy.loc[yoy['rateDiff'].idxmax()]\n\n    return pd.DataFrame([{\n        'metric': 'marineAvgExceedanceRateDiff',\n        'year': int(max_row['Year']),\n        'value': float(max_row['rateDiff']),\n    }])\n"
        },
