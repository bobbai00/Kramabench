      {
        "operatorID": "jjaRainYoY",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(rainBoston, rainChatham) -> pd.DataFrame:\n    import pandas as pd\n    import numpy as np\n\n    def prep(df: pd.DataFrame) -> pd.DataFrame:\n        out = df.copy()\n        # keep rows where Year is numeric\n        out['YearNum'] = pd.to_numeric(out['Year'], errors='coerce')\n        out = out[out['YearNum'].notna()].copy()\n\n        # Parse monthly values; treat 'M', 'T', blanks as missing\n        month_cols = ['Jun', 'Jul', 'Aug']\n        for c in month_cols:\n            out[c] = (\n                out[c]\n                .astype(str)\n                .str.strip()\n                .replace({'M': np.nan, 'm': np.nan, 'T': np.nan, 't': np.nan, '': np.nan, 'nan': np.nan, 'None': np.nan})\n            )\n            out[c] = pd.to_numeric(out[c], errors='coerce')\n\n        # Impute missing with median of that month across non-missing years\n        for c in month_cols:\n            med = out[c].median(skipna=True)\n            out[c] = out[c].fillna(med)\n\n        out['jjaTotal'] = out[month_cols].sum(axis=1)\n        return out[['YearNum', 'jjaTotal']].rename(columns={'YearNum': 'Year'})\n\n    b = prep(rainBoston).rename(columns={'jjaTotal': 'bostonJja'})\n    c = prep(rainChatham).rename(columns={'jjaTotal': 'chathamJja'})\n\n    merged = b.merge(c, on='Year', how='inner').sort_values('Year')\n    merged['totalJjaRain'] = merged['bostonJja'] + merged['chathamJja']\n    merged['prevTotalJjaRain'] = merged['totalJjaRain'].shift(1)\n    merged['rainDiff'] = merged['totalJjaRain'] - merged['prevTotalJjaRain']\n\n    yoy = merged.dropna(subset=['rainDiff']).copy()\n    max_row = yoy.loc[yoy['rainDiff'].idxmax()]\n\n    return pd.DataFrame([{\n        'metric': 'totalJjaRainDiff',\n        'year': int(max_row['Year']),\n        'value': float(max_row['rainDiff']),\n    }])\n"
        },
