      {
        "operatorID": "quincyWollastonPct",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(waterBody2019, waterBody2020, waterBody2021, waterBody2022, waterBody2023):\n    import pandas as pd\n\n    df = pd.concat(\n        [waterBody2019, waterBody2020, waterBody2021, waterBody2022, waterBody2023],\n        ignore_index=True,\n        sort=False,\n    )\n\n    # Normalize strings\n    df['communityNorm'] = df['Community'].astype(str).str.strip().str.upper()\n    df['beachNorm'] = df['Beach Name'].astype(str).str.strip().str.upper()\n    df['violationNorm'] = df['Violation'].astype(str).str.strip().str.upper()\n\n    # Filter to Quincy + Wollaston Beach (some datasets may include full name variants)\n    is_quincy = df['communityNorm'].eq('QUINCY')\n    is_wollaston = df['beachNorm'].str.contains('WOLLASTON', na=False)\n\n    sub = df[is_quincy & is_wollaston].copy()\n\n    total = int(len(sub))\n    met = int((sub['violationNorm'] == 'NO').sum())\n    pct = int(round(100 * met / total)) if total > 0 else None\n\n    return pd.DataFrame([{'percentageMet': pct, 'totalSamples': total, 'metSamples': met}])\n"
        },
