      },
      {
        "operatorID": "freshExceedanceRates",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load2002, load2003, load2004, load2005, load2006, load2007, load2008, load2009, load2010, load2011, load2012, load2013, load2014, load2015, load2016, load2017, load2018, load2019, load2020, load2021, load2022, load2023) -> pd.DataFrame:\n    import pandas as pd\n\n    frames = [\n        load2002, load2003, load2004, load2005, load2006, load2007, load2008, load2009,\n        load2010, load2011, load2012, load2013, load2014, load2015, load2016, load2017,\n        load2018, load2019, load2020, load2021, load2022, load2023,\n    ]\n    df = pd.concat(frames, ignore_index=True)\n\n    # Freshwater beaches only\n    df = df[df['Beach Type Description'].astype(str).str.strip().str.lower().eq('fresh')].copy()\n\n    # Violation indicates exceedance; normalize value variants (yes/YES/Yes)\n    v = df['Violation'].astype(str).str.strip().str.lower()\n    df['_isExceed'] = v.eq('yes')\n\n    rates = (\n        df.groupby('Year', as_index=False)\n          .agg(totalSamples=('Violation', 'size'), exceedances=('_isExceed', 'sum'))\n    )\n    rates['exceedanceRate'] = rates['exceedances'] / rates['totalSamples']\n\n    avg_rate = rates['exceedanceRate'].mean()\n    rates['avgExceedanceRate'] = avg_rate\n\n    # Compare rounded-to-2-decimal rates (as requested)\n    rates['exceedanceRate_r2'] = rates['exceedanceRate'].round(2)\n    rates['avgExceedanceRate_r2'] = round(float(avg_rate), 2)\n    rates['aboveAvg_r2'] = rates['exceedanceRate_r2'] > rates['avgExceedanceRate_r2']\n\n    return rates.sort_values('Year').reset_index(drop=True)\n"
        },
