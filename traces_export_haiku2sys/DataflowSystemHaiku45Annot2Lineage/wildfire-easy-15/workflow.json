      {
        "operatorID": "correlation_analysis",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(july_fires) -> pd.DataFrame:\n    import numpy as np\n    from scipy import stats\n    \n    # Extract the relevant columns for July fires\n    # hec = hectares (fire size), wind_med = median wind speed\n    df = july_fires[['hec', 'wind_med']].dropna()\n    \n    # Calculate Pearson correlation coefficient\n    correlation = df['hec'].corr(df['wind_med'])\n    \n    # Calculate p-value for statistical significance\n    pearson_r, p_value = stats.pearsonr(df['hec'], df['wind_med'])\n    \n    # Create result dataframe\n    result = pd.DataFrame({\n        'metric': ['Pearson Correlation', 'P-value', 'Sample Size', 'Strong Correlation (|r| > 0.7)'],\n        'value': [f'{pearson_r:.4f}', f'{p_value:.6f}', str(len(df)), 'Yes' if abs(pearson_r) > 0.7 else 'No']\n    })\n    \n    return result\n"
        },
