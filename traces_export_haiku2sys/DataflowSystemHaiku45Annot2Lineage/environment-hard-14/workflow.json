        "customDisplayName": "Map freshwater beach exceedance rates with average precipitation from all four cities (Boston, Chatham, Amherst, Ashburnham)",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "marine_precip_mapping",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(precip_summer_avg, exceedance_by_beach_year):\n    precip_marine = precip_summer_avg[precip_summer_avg['City'].isin(['Boston', 'Chatham'])]\n    exceedance_marine = exceedance_by_beach_year[exceedance_by_beach_year['Beach Type Description'] == 'Marine'].copy()\n    \n    # Average precipitation across Boston and Chatham for marine\n    precip_avg = precip_marine.groupby('Year')['avg_summer_precip'].mean().reset_index()\n    precip_avg.columns = ['Year', 'avg_rainfall']\n    \n    # Merge with exceedance rates\n    result = exceedance_marine.merge(precip_avg, on='Year', how='inner')\n    return result[['Year', 'avg_rainfall', 'violation_rate']]\n"
        },
