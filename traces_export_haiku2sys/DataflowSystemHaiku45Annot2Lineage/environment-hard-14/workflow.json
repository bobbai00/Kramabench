        "operatorProperties": {
          "code": "\ndef load() -> pd.DataFrame:\n    import glob\n    dfs = []\n    for f in sorted(glob.glob('data/environment/input/monthly_precipitations_*.csv')):\n        city = f.split('/')[-1].replace('monthly_precipitations_', '').replace('.csv', '').title()\n        df = pd.read_csv(f)\n        df['City'] = city\n        dfs.append(df)\n    return pd.concat(dfs, ignore_index=True)\n"
        },
