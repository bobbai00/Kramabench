      },
      {
        "operatorID": "precip_summer_avg",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(precip_summer_2007_2009):\n    df = precip_summer_2007_2009.copy()\n    df['avg_summer_precip'] = (df['Jun'] + df['Jul'] + df['Aug']) / 3\n    return df[['Year', 'City', 'avg_summer_precip']]\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
