      },
      {
        "operatorID": "exceedance_by_beach_year",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(water_summer_2007_2009):\n    df = water_summer_2007_2009.copy()\n    df['Violation_numeric'] = (df['Violation'].str.lower() == 'yes').astype(int)\n    exceedance = df.groupby(['Year', 'Beach Type Description']).agg(\n        violation_rate=('Violation_numeric', 'mean'),\n        sample_count=('Violation_numeric', 'count')\n    ).reset_index()\n    return exceedance\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
