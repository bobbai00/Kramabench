      {
        "operatorID": "precip_summer_2007_2009",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(precip_combined) -> pd.DataFrame:\n    df = precip_combined[precip_combined['Year'].notna()].copy()\n    df['Year'] = pd.to_numeric(df['Year'], errors='coerce')\n    df = df[df['Year'].notna()].copy()\n    df = df[(df['Year'] >= 2007) & (df['Year'] <= 2009)]\n    \n    for month in ['Jun', 'Jul', 'Aug']:\n        df[month] = pd.to_numeric(df[month], errors='coerce')\n    \n    return df[['Year', 'City', 'Jun', 'Jul', 'Aug']].reset_index(drop=True)"
        },
