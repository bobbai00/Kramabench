        "customDisplayName": "Calculate average summer (Jun, Jul, Aug) precipitation by city and year",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "freshwater_precip_mapping",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(precip_summer_avg, exceedance_by_beach_year):\n    precip_fresh = precip_summer_avg[precip_summer_avg['City'].isin(['Boston', 'Chatham', 'Amherst', 'Ashburnham'])]\n    exceedance_fresh = exceedance_by_beach_year[exceedance_by_beach_year['Beach Type Description'] == 'Fresh'].copy()\n    \n    # Average precipitation across all cities for freshwater (since multiple regions affect freshwater)\n    precip_avg = precip_fresh.groupby('Year')['avg_summer_precip'].mean().reset_index()\n    precip_avg.columns = ['Year', 'avg_rainfall']\n    \n    # Merge with exceedance rates\n    result = exceedance_fresh.merge(precip_avg, on='Year', how='inner')\n    return result[['Year', 'avg_rainfall', 'violation_rate']]\n"
        },
