        "customDisplayName": "Map marine beach exceedance rates with average precipitation from Boston and Chatham",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "correlation_analysis",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(freshwater_precip_mapping, marine_precip_mapping):\n    import numpy as np\n    \n    # Freshwater correlation\n    fw_rainfall = freshwater_precip_mapping['avg_rainfall'].values\n    fw_violation = freshwater_precip_mapping['violation_rate'].values\n    fw_corr = np.corrcoef(fw_rainfall, fw_violation)[0, 1]\n    \n    # Marine correlation\n    m_rainfall = marine_precip_mapping['avg_rainfall'].values\n    m_violation = marine_precip_mapping['violation_rate'].values\n    m_corr = np.corrcoef(m_rainfall, m_violation)[0, 1]\n    \n    result = pd.DataFrame({\n        'Beach_Type': ['Freshwater', 'Marine'],\n        'Correlation': [fw_corr, m_corr],\n        'Abs_Correlation': [abs(fw_corr), abs(m_corr)]\n    })\n    \n    return result\n"
        },
