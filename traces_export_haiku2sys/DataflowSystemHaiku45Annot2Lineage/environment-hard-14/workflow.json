      },
      {
        "operatorID": "water_summer_2007_2009",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(water_combined) -> pd.DataFrame:\n    df = water_combined[(water_combined['Year'] >= 2007) & (water_combined['Year'] <= 2009)].copy()\n    df['Sample Date'] = pd.to_datetime(df['Sample Date'])\n    df['Month'] = df['Sample Date'].dt.month\n    df = df[df['Month'].isin([6, 7, 8])].copy()\n    return df"
        },
