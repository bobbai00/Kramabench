        "operatorID": "parse_amounts",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(fraud_data) -> pd.DataFrame:\n    df = fraud_data.dropna(how='all').drop_duplicates().reset_index(drop=True)\n    col_names = df.columns.tolist()\n    payment_col = col_names[0]\n    amount_col = col_names[2]\n    \n    df = df[df[payment_col].notna()].reset_index(drop=True)\n    df = df[~df[payment_col].str.contains('Payment Method|Reports|Source|Total|#', na=False, regex=True)]\n    \n    def parse_amount(val):\n        if pd.isna(val):\n            return None\n        val = str(val).replace('$', '').replace('M', '').replace(',', '').strip()\n        try:\n            return float(val)\n        except:\n            return None\n    \n    df['amount_millions'] = df[amount_col].apply(parse_amount)\n    df = df[df['amount_millions'].notna()]\n    return df[[payment_col, 'amount_millions']]"
        },
