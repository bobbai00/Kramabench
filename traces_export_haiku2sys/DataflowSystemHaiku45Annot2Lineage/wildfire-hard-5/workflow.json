        "operatorProperties": {
          "code": "\ndef process(nifc_clean, noaa_annual) -> pd.DataFrame:\n    nifc = nifc_clean.sort_values('Year').reset_index(drop=True)\n    noaa = noaa_annual.sort_values('Year').reset_index(drop=True)\n    \n    merged = nifc.merge(noaa, on='Year', suffixes=('_nifc', '_noaa'))\n    merged['fires_diff'] = merged['Fires_noaa'] - merged['Fires_nifc']\n    \n    return merged\n"
