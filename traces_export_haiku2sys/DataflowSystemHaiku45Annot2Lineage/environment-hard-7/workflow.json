      },
      {
        "operatorID": "exceedance_by_category",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(marine_with_ej) -> pd.DataFrame:\n    # Filter for high (>50%) and low (<25%) EJ categories only\n    filtered = marine_with_ej[marine_with_ej['EJ_category'].isin(['high', 'low'])].copy()\n    \n    # Calculate exceedance rate by EJ category\n    # Exceedance = Violation == 'Yes'\n    result = filtered.groupby('EJ_category').agg(\n        total_samples=('Violation', 'count'),\n        exceedances=('Violation', lambda x: (x == 'Yes').sum())\n    ).reset_index()\n    \n    result['exceedance_rate'] = (result['exceedances'] / result['total_samples'] * 100).round(2)\n    return result\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
