      {
        "operatorID": "ej_high_low",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(ej_populations) -> pd.DataFrame:\n    df = ej_populations[['Municipality', 'Percent of population in EJ BGs']].copy()\n    df.rename(columns={'Municipality': 'Community'}, inplace=True)\n    df['EJ_category'] = df['Percent of population in EJ BGs'].apply(\n        lambda x: 'high' if x > 50 else ('low' if x < 25 else 'mid')\n    )\n    return df"
        },
        "inputPorts": [
