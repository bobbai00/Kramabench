        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Calculate bacterial exceedance rate (Violation='Yes') by EJ category (high vs low)",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "rate_difference",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(exceedance_by_category) -> pd.DataFrame:\n    high_rate = exceedance_by_category[exceedance_by_category['EJ_category'] == 'high']['exceedance_rate'].values[0]\n    low_rate = exceedance_by_category[exceedance_by_category['EJ_category'] == 'low']['exceedance_rate'].values[0]\n    \n    difference = high_rate - low_rate\n    \n    return pd.DataFrame({\n        'EJ_category_high': ['high'],\n        'exceedance_rate_high': [high_rate],\n        'EJ_category_low': ['low'],\n        'exceedance_rate_low': [low_rate],\n        'difference': [round(difference, 2)]\n    })\n"
        },
