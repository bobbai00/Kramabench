      },
      {
        "operatorID": "calculate_ratio",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(extract_identity_theft) -> pd.DataFrame:\n    data = extract_identity_theft.sort_values('Year')\n    reports_2001 = data[data['Year'] == 2001]['Identity_Theft'].values[0]\n    reports_2024 = data[data['Year'] == 2024]['Identity_Theft'].values[0]\n    ratio = reports_2024 / reports_2001\n    return pd.DataFrame({'Ratio_2024_vs_2001': [round(ratio, 4)]})\n"
        },
