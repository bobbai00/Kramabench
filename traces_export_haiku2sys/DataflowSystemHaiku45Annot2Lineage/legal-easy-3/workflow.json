      {
        "operatorID": "extract_identity_theft",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_reports) -> pd.DataFrame:\n    df = load_reports.copy()\n    df.columns = ['Year', 'Fraud', 'Identity_Theft', 'Other']\n    df = df[df['Year'].notna()].copy()\n    df = df[df['Year'] != 'Year'].copy()\n    df = df[~df['Year'].str.contains('Source', na=False, case=False)].copy()\n    df['Year'] = pd.to_numeric(df['Year'], errors='coerce')\n    df = df[df['Year'].notna()].copy()\n    df['Identity_Theft'] = df['Identity_Theft'].str.replace(',', '').astype(int)\n    return df[df['Year'].isin([2001, 2024])][['Year', 'Identity_Theft']]"
        },
        "inputPorts": [
