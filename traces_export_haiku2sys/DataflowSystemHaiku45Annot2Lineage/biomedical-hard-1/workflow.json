        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Extract PLK1 protein abundance from global proteomics data and reshape into long format with sample IDs",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "extract_chek2_s163",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_phospho_proteomics) -> pd.DataFrame:\n    df = load_phospho_proteomics.copy()\n    df_idx = df[df['idx'].str.contains('CHEK2-S163', na=False)]\n    \n    if len(df_idx) == 0:\n        return pd.DataFrame({'sample_id': [], 'CHEK2_S163': []})\n    \n    sample_cols = [col for col in df.columns if col.startswith('S') and col[1:].isdigit()]\n    result_rows = []\n    for _, row in df_idx.iterrows():\n        for col in sample_cols:\n            result_rows.append({'sample_id': col, 'CHEK2_S163': row[col]})\n    \n    return pd.DataFrame(result_rows)\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
            "isDynamicPort": false,
            "dependencies": []
