        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(merge_proteomics) -> pd.DataFrame:\n    df = merge_proteomics[['sample_id', 'PLK1', 'CHEK2_S163']].copy()\n    df = df.dropna(subset=['PLK1', 'CHEK2_S163'])\n    return df"
        },
