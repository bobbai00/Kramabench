            "isDynamicPort": false
          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Extract CHEK2-S163 phosphosite abundance from phosphoproteomics data and reshape into long format with sample IDs",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "merge_proteomics",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(extract_plk1, extract_chek2_s163, filter_tumor_samples):\n    plk1 = extract_plk1.copy()\n    chek2 = extract_chek2_s163.copy()\n    tumor_meta = filter_tumor_samples[['idx']].copy()\n    \n    merged = plk1.merge(chek2, on='sample_id', how='inner')\n    merged = merged.merge(tumor_meta.rename(columns={'idx': 'sample_id'}), on='sample_id', how='inner')\n    \n    return merged\n"
        },
        "inputPorts": [
          {
