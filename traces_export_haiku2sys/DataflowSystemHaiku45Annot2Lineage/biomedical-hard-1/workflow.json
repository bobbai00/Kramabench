      {
        "operatorID": "filter_tumor_samples",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(load_mmc1) -> pd.DataFrame:\n    df = load_mmc1.copy()\n    # Filter for tumor samples only\n    df = df[df['Proteomics_Tumor_Normal'] == 'Tumor']\n    # Exclude samples marked as excluded\n    df = df[df['Case_excluded'] == 'No']\n    return df\n"
        },
