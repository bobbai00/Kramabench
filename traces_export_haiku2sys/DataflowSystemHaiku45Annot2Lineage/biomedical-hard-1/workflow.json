      },
      {
        "operatorID": "calculate_spearman_correlation",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(remove_missing_values):\n    from scipy.stats import spearmanr\n    \n    # Calculate Spearman correlation\n    correlation, p_value = spearmanr(remove_missing_values['PLK1'], remove_missing_values['CHEK2_S163'])\n    \n    # Create result dataframe with the correlation coefficient rounded to 4 decimal places\n    result = pd.DataFrame({\n        'correlation': [round(correlation, 4)],\n        'p_value': [p_value],\n        'n_samples': [len(remove_missing_values)]\n    })\n    \n    return result"
        },
        "inputPorts": [
