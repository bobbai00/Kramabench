      },
      {
        "operatorID": "search_plk1_chek2",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(load_global_proteomics, load_phospho_proteomics):\n    global_proteins = load_global_proteomics\n    phospho_proteins = load_phospho_proteomics\n    \n    # Find PLK1 in global proteomics (should be a single row)\n    plk1_rows = global_proteins[global_proteins['idx'].str.contains('PLK1', case=False, na=False)]\n    \n    # Find CHEK2 phospho sites (looking for CHEK2-S163)\n    chek2_rows = phospho_proteins[phospho_proteins['idx'].str.contains('CHEK2', case=False, na=False)]\n    \n    # Create result dataframe showing what we found\n    result = pd.DataFrame({\n        'protein': ['PLK1', 'CHEK2 phospho sites'],\n        'count': [len(plk1_rows), len(chek2_rows)]\n    })\n    \n    return result\n"
        },
