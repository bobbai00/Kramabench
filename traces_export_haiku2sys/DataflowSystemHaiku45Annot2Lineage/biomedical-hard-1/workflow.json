      },
      {
        "operatorID": "extract_plk1",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_global_proteomics) -> pd.DataFrame:\n    df = load_global_proteomics[load_global_proteomics['idx'] == 'PLK1'].copy()\n    df = df.set_index('idx').T\n    df = df.reset_index()\n    df.columns = ['sample_id', 'PLK1']\n    df['sample_id'] = df['sample_id'].str.replace('S', '').astype(int)\n    df['sample_id'] = 'S' + df['sample_id'].astype(str).str.zfill(3)\n    return df\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
