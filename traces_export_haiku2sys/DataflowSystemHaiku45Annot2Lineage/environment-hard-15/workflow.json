        "operatorProperties": {
          "code": "def process(fresh_water_data):\n    df = fresh_water_data.copy()\n    df['Exceedance'] = (df['Violation'] == 'YES').astype(int)\n    result = df.groupby(['Beach Name', 'Year']).agg({\n        'Exceedance': 'sum',\n        'Violation': 'count'\n    }).reset_index()\n    result.columns = ['Beach Name', 'Year', 'Violations', 'Total_Samples']\n    result['Exceedance_Rate'] = result['Violations'] / result['Total_Samples']\n    return result\n"
        },
