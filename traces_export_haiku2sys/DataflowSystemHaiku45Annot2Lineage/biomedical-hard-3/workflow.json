        "operatorProperties": {
          "code": "\ndef load() -> pd.DataFrame:\n    import openpyxl\n    xl = openpyxl.load_workbook('data/biomedical/input/1-s2.0-S0092867420301070-mmc7.xlsx')\n    sheets = xl.sheetnames\n    dfs = {}\n    for sheet in sheets:\n        df = pd.read_excel('data/biomedical/input/1-s2.0-S0092867420301070-mmc7.xlsx', sheet_name=sheet)\n        dfs[sheet] = df\n    \n    result_rows = []\n    for sheet_name, df in dfs.items():\n        cols_str = ', '.join(df.columns[:10].tolist())\n        result_rows.append({\n            'Sheet': sheet_name,\n            'Columns_Sample': cols_str,\n            'Shape': f'{df.shape[0]} rows x {df.shape[1]} cols'\n        })\n    return pd.DataFrame(result_rows)\n"
        },
