        "operatorProperties": {
          "code": "\ndef process(suppression_costs) -> pd.DataFrame:\n    df = suppression_costs.copy()\n    df['Year'] = df['Year'].astype(int)\n    df['Acres'] = df['Acres'].str.replace(',', '').astype(int)\n    df['Total'] = df['Total'].str.replace('$', '').str.replace(',', '').astype(float)\n    return df[['Year', 'Acres', 'Total']]\n"
        },
