        "operatorID": "calculate_yearly_rates",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(normalize_violation) -> pd.DataFrame:\n    yearly = normalize_violation.groupby('Year').agg(\n        total_samples=('Violation', 'count'),\n        violations=('Violation', lambda x: (x == 'yes').sum())\n    ).reset_index()\n    yearly['exceedance_rate'] = yearly['violations'] / yearly['total_samples']\n    return yearly\n"
