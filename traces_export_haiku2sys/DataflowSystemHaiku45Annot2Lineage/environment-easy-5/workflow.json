        "operatorProperties": {
          "code": "\ndef process(boston_data) -> pd.DataFrame:\n    df = boston_data[boston_data['Year'] == '2020'].copy()\n    if len(df) > 0:\n        jun = pd.to_numeric(df['Jun'].iloc[0], errors='coerce')\n        jul = pd.to_numeric(df['Jul'].iloc[0], errors='coerce')\n        aug = pd.to_numeric(df['Aug'].iloc[0], errors='coerce')\n        total = jun + jul + aug\n        return pd.DataFrame({'Region': ['Boston'], 'Jun': [jun], 'Jul': [jul], 'Aug': [aug], 'Total': [total]})\n    return pd.DataFrame({'Region': ['Boston'], 'Jun': [None], 'Jul': [None], 'Aug': [None], 'Total': [None]})\n"
