        "operatorProperties": {
          "code": "def process(filter_bank_new_accounts, report_type_clean) -> pd.DataFrame:\n    bank_new = filter_bank_new_accounts['Num_Reports'].iloc[0]\n    total_identity_theft = report_type_clean['Num_Reports'].iloc[0]\n    proportion = bank_new / total_identity_theft\n    return pd.DataFrame({'Proportion': [round(proportion, 4)]})\n"
