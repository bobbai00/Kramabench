      {
        "operatorID": "identity_theft_clean",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(identity_theft_reports) -> pd.DataFrame:\n    df = identity_theft_reports.copy()\n    # Skip header rows and clean up\n    df = df.iloc[1:].copy()\n    df.columns = ['Theft_Type', 'Theft_Subtype', 'Num_Reports', 'Pct_Diff']\n    # Remove all-null and source rows\n    df = df.dropna(how='all')\n    df = df[~df['Theft_Type'].str.contains('Source:', case=False, na=False)]\n    # Clean up the number format (remove commas)\n    df['Num_Reports'] = df['Num_Reports'].str.replace(',', '')\n    df['Num_Reports'] = pd.to_numeric(df['Num_Reports'], errors='coerce')\n    return df.dropna(subset=['Num_Reports'])\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
            "isDynamicPort": false,
            "dependencies": []
          }
        ],
        "outputPorts": [
