            "portID": "output-0",
            "displayName": "",
            "disallowMultiInputs": false,
            "isDynamicPort": false
          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Clean identity theft reports: rename columns, remove metadata rows, parse numeric reports column",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "report_type_clean",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(report_type) -> pd.DataFrame:\n    df = report_type.copy()\n    # Keep only the first row which has the data\n    df = df.iloc[0:2].copy()\n    df.columns = ['Report_Type', 'Num_Reports', 'col2', 'col3', 'col4', 'col5']\n    # Keep only relevant columns and first row (Identity Theft)\n    df = df[['Report_Type', 'Num_Reports']].iloc[1:].copy()\n    df['Num_Reports'] = df['Num_Reports'].str.replace(',', '')\n    df['Num_Reports'] = pd.to_numeric(df['Num_Reports'], errors='coerce')\n    return df\n"
        },
