      },
      {
        "operatorID": "contingency_table",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(filter_jan_feb_mar) -> pd.DataFrame:\n    df = filter_jan_feb_mar.copy()\n    contingency = pd.crosstab(df['region'], df['cause'])\n    return contingency.reset_index()\n"
