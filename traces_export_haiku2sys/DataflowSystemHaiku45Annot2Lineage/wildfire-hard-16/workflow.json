        "customDisplayName": "Create contingency table of region vs cause for chi-square test. Shows breakdown of fire causes by geographical region for Jan-Mar fires with known causes.",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "chi_square_test",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\nfrom scipy.stats import chi2_contingency\n\ndef process(contingency_table):\n    ct = contingency_table.set_index('region')[['H', 'L', 'N']]\n    chi2, p_value, dof, expected = chi2_contingency(ct.values)\n    result_df = pd.DataFrame({\n        'statistic': [chi2],\n        'p_value': [p_value]\n    })\n    return result_df\n"
        },
