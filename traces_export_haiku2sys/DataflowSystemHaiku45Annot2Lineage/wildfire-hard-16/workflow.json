      {
        "operatorID": "filter_jan_feb_mar",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(load_wildfires) -> pd.DataFrame:\n    df = load_wildfires.copy()\n    df['start_date'] = pd.to_datetime(df['start_date'])\n    df['month'] = df['start_date'].dt.month\n    filtered = df[(df['month'].isin([1, 2, 3])) & (df['cause'] != 'U')]\n    return filtered[['region', 'cause', 'month']]\n"
        },
