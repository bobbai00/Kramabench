      {
        "operatorID": "calculate_avg_rank",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(greece_cities) -> pd.DataFrame:\n    ranks = []\n    for rank_str in greece_cities['Barrington Atlas Rank']:\n        if 'or' in str(rank_str):\n            parts = str(rank_str).split(' or ')\n            num1 = float(parts[0].strip())\n            num2 = float(parts[1].strip())\n            avg_rank = (num1 + num2) / 2\n            ranks.append(avg_rank)\n        else:\n            ranks.append(float(rank_str))\n    \n    avg = sum(ranks) / len(ranks)\n    return pd.DataFrame({'average_rank': [round(avg, 4)]})\n"
        },
        "inputPorts": [
