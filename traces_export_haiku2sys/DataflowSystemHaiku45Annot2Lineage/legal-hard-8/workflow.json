        "operatorProperties": {
          "code": "\ndef process(florida_fraud_other) -> pd.DataFrame:\n    df = florida_fraud_other.copy()\n    df.columns = ['area', 'reports']\n    df = df[df['area'].notna() & (df['area'] != 'Metropolitan Area')].copy()\n    df = df[~df['area'].str.contains('Source:', na=False)].copy()\n    df = df[~df['area'].str.contains('Metropolitan Areas are defined', na=False)].copy()\n    df['reports'] = df['reports'].str.replace(',', '')\n    df = df[df['reports'].notna()].copy()\n    df['reports'] = pd.to_numeric(df['reports'], errors='coerce')\n    return df.dropna()\n"
