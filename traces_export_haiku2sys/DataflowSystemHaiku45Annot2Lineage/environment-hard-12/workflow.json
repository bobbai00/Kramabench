      {
        "operatorID": "process_all_beaches",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(constitution_beach_clean, m_street_beach_clean, city_point_beach_clean, carson_beach_clean, tenean_beach_clean, malibu_beach_clean, wollaston_beach_clean, pleasure_bay_beach_clean):\n    dfs = [\n        constitution_beach_clean,\n        m_street_beach_clean,\n        city_point_beach_clean,\n        carson_beach_clean,\n        tenean_beach_clean,\n        malibu_beach_clean,\n        wollaston_beach_clean,\n        pleasure_bay_beach_clean\n    ]\n    \n    processed = []\n    for df in dfs:\n        beach_name = df['beach_name'].iloc[0]\n        temp = df[['Date', '3-Day Rain', 'beach_name']].copy()\n        \n        enterococcus_cols = [col for col in df.columns if col.startswith('Enterococcus')]\n        for ent_col in enterococcus_cols:\n            temp[f'{ent_col}_value'] = pd.to_numeric(df[ent_col], errors='coerce')\n        \n        processed.append(temp)\n    \n    result = pd.concat(processed, ignore_index=True)\n    return result\n"
        },
