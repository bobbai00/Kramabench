      },
      {
        "operatorID": "all_beaches_melted",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(constitution_beach_clean, m_street_beach_clean, city_point_beach_clean, carson_beach_clean, tenean_beach_clean, malibu_beach_clean, wollaston_beach_clean, pleasure_bay_beach_clean) -> pd.DataFrame:\n    dfs = []\n    \n    for df, name in [\n        (constitution_beach_clean, 'Constitution Beach'),\n        (m_street_beach_clean, 'M Street Beach'),\n        (city_point_beach_clean, 'City Point Beach'),\n        (carson_beach_clean, 'Carson Beach'),\n        (tenean_beach_clean, 'Tenean Beach'),\n        (malibu_beach_clean, 'Malibu Beach'),\n        (wollaston_beach_clean, 'Wollaston Beach'),\n        (pleasure_bay_beach_clean, 'Pleasure Bay and Castle Island Beach')\n    ]:\n        df = df.copy()\n        df['beach_name'] = name\n        \n        # Get Enterococcus columns (may have suffixes like .1, .2, .3)\n        ent_cols = [col for col in df.columns if 'Enterococcus' in col]\n        \n        # Melt to long format\n        id_vars = ['Date', '3-Day Rain', 'beach_name']\n        if len(ent_cols) > 0:\n            melted = pd.melt(df, id_vars=id_vars, value_vars=ent_cols, var_name='location', value_name='enterococcus_count')\n            melted = melted.dropna(subset=['enterococcus_count'])\n            melted['enterococcus_count'] = pd.to_numeric(melted['enterococcus_count'], errors='coerce')\n            melted = melted.dropna(subset=['enterococcus_count'])\n            dfs.append(melted)\n    \n    return pd.concat(dfs, ignore_index=True)\n"
        },
