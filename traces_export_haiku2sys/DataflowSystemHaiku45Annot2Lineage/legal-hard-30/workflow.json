      {
        "operatorID": "clean_fraud_data",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_fraud_data) -> pd.DataFrame:\n    df = load_fraud_data.copy()\n    df = df.dropna(how='all')\n    df = df[df['Metropolitan Areas: Fraud and Other Reports'].notna()]\n    df = df[df['Metropolitan Areas: Fraud and Other Reports'] != 'Metropolitan Area']\n    df = df[df['Metropolitan Areas: Fraud and Other Reports'] != 'Source: Consumer Sentinel Network Data Book 2024, Federal Trade Commission']\n    df = df[df['Unnamed: 1'].notna()]\n    df = df.drop_duplicates()\n    df.columns = ['metropolitan_area', 'fraud_reports']\n    df['fraud_reports'] = df['fraud_reports'].astype(str).str.replace(',', '').astype(int)\n    return df"
        },
