        "operatorProperties": {
          "code": "def process(clean_fraud_data, clean_identity_theft_data) -> pd.DataFrame:\n    merged = clean_fraud_data.merge(clean_identity_theft_data, on='metropolitan_area', how='inner')\n    merged['identity_theft_exceeds_fraud'] = merged['identity_theft_reports'] > merged['fraud_reports']\n    return merged\n"
