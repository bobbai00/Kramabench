      {
        "operatorID": "clean_identity_theft_data",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_identity_theft_data) -> pd.DataFrame:\n    df = load_identity_theft_data.copy()\n    df = df.dropna(how='all')\n    df = df[df['Metropolitan Areas: Identity Theft Reports'].notna()]\n    df = df[df['Metropolitan Areas: Identity Theft Reports'] != 'Metropolitan Area']\n    df = df[df['Metropolitan Areas: Identity Theft Reports'] != 'Source: Consumer Sentinel Network Data Book 2024, Federal Trade Commission']\n    df = df[df['Unnamed: 1'].notna()]\n    df = df.drop_duplicates()\n    df.columns = ['metropolitan_area', 'identity_theft_reports']\n    df['identity_theft_reports'] = df['identity_theft_reports'].astype(str).str.replace(',', '').astype(int)\n    return df"
