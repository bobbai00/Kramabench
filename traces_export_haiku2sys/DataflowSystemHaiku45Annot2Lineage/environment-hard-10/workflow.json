      {
        "operatorID": "verify_answer",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(wollaston_adjusted, high_ej_communities_list):\n    import numpy as np\n    \n    # Check: Wollaston Beach is in Quincy\n    # Quincy is in the high_ej_communities_list with 90.2% EJ\n    \n    # Verify the correlation calculation\n    if len(wollaston_adjusted) > 0:\n        rain = wollaston_adjusted['Rain_3day'].dropna()\n        entero = wollaston_adjusted['Entero_Adjusted'].dropna()\n        \n        # Use complete pairs only\n        valid_mask = (wollaston_adjusted['Rain_3day'].notna()) & (wollaston_adjusted['Entero_Adjusted'].notna())\n        rain_valid = wollaston_adjusted.loc[valid_mask, 'Rain_3day']\n        entero_valid = wollaston_adjusted.loc[valid_mask, 'Entero_Adjusted']\n        \n        if len(rain_valid) > 0:\n            correlation = rain_valid.corr(entero_valid)\n        else:\n            correlation = None\n    else:\n        correlation = None\n    \n    return pd.DataFrame({\n        'Total_Records': [len(wollaston_adjusted)],\n        'Records_with_Both_Values': [len(rain_valid) if len(rain_valid) > 0 else 0],\n        'Pearson_Correlation': [round(correlation, 3) if correlation is not None else None],\n        'Quincy_in_HighEJ': ['Quincy' in high_ej_communities_list['Municipality'].values]\n    })\n"
