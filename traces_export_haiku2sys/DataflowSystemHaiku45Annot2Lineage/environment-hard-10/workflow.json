      {
        "operatorID": "parse_wollaston",
        "operatorType": "DataLoading",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef load() -> pd.DataFrame:\n    df = pd.read_csv('data/environment/input/wollaston_beach_datasheet.csv', header=None)\n    \n    # The structure is:\n    # Row 0: Title\n    # Row 1: Location headers (Milton Road, Channing Street, Sachem Street, Rice Road)\n    # Row 2: Tags (Date, 1-Day Rain, 2-Day Rain, 3-Day Rain, Enterococcus, ...)\n    # Rows 3+: Data\n    \n    # Extract the location names from row 1\n    locations = []\n    for i in [4, 6, 8, 10]:\n        locations.append(df.iloc[1, i])\n    \n    # Extract tag row to understand structure\n    # Row 2 should have the tags\n    # Let's reconstruct properly\n    \n    # Read the actual data starting from row 3 (skip title and headers)\n    data_rows = []\n    for idx in range(3, len(df)):\n        row = df.iloc[idx]\n        date = row[0]\n        if pd.isna(date) or date == '':\n            continue\n        \n        # Each location occupies 2 columns: rainfall (3-day) and enterococcus\n        # Column 1: 1-day rain (Milton Road)\n        # Column 2: 2-day rain (Milton Road) \n        # Column 3: 3-day rain (Milton Road)\n        # Column 4: Enterococcus tag/value (Milton Road)\n        # Column 5: Enterococcus value (Milton Road)\n        # Columns repeat for Channing Street, Sachem Street, Rice Road\n        \n        for loc_idx, location in enumerate(locations):\n            base_col = 1 + loc_idx * 2\n            col_3day_rain = 3\n            col_entero_tag = 4 + loc_idx * 2\n            col_entero_val = 5 + loc_idx * 2\n            \n        # Actually, let's look at the pattern more carefully\n        # Based on the inspection, it seems:\n        # Cols 1-3: 1-day, 2-day, 3-day rain (same for all locations)\n        # Col 4: tag/value for Milton Road\n        # Col 5: value for Milton Road\n        # Col 6: tag/value for Channing Street\n        # Col 7: value for Channing Street\n        # Col 8: tag/value for Sachem Street\n        # Col 9: value for Sachem Street\n        # Col 10: tag/value for Rice Road\n        # Col 11: value for Rice Road\n        \n        rain_3day = row[3]\n        \n        for loc_idx, location in enumerate(locations):\n            tag_col = 4 + loc_idx * 2\n            val_col = 5 + loc_idx * 2\n            \n            tag = row[tag_col]\n            val = row[val_col]\n            \n            if pd.isna(val) or val == '':\n                continue\n            \n            data_rows.append({\n                'Date': date,\n                'Location': location,\n                'Rain_3day': rain_3day,\n                'Entero_Tag': tag,\n                'Entero_Value': val\n            })\n    \n    result = pd.DataFrame(data_rows)\n    \n    # Convert to numeric\n    result['Rain_3day'] = pd.to_numeric(result['Rain_3day'], errors='coerce')\n    result['Entero_Value'] = pd.to_numeric(result['Entero_Value'], errors='coerce')\n    \n    return result\n"
        },
