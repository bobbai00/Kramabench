      {
        "operatorID": "wollaston_adjusted",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(parse_wollaston) -> pd.DataFrame:\n    df = parse_wollaston.copy()\n    \n    df['Entero_Adjusted'] = df['Entero_Value'].copy()\n    \n    mask_less = df['Entero_Tag'] == '<'\n    df.loc[mask_less, 'Entero_Adjusted'] = df.loc[mask_less, 'Entero_Value'] / 2\n    \n    mask_greater = df['Entero_Tag'] == '>'\n    df.loc[mask_greater, 'Entero_Adjusted'] = df.loc[mask_greater, 'Entero_Value']\n    \n    mask_nan = df['Entero_Tag'].isna()\n    df.loc[mask_nan, 'Entero_Adjusted'] = df.loc[mask_nan, 'Entero_Value']\n    \n    return df[['Date', 'Location', 'Rain_3day', 'Entero_Value', 'Entero_Tag', 'Entero_Adjusted']]\n"
        },
        "inputPorts": [
