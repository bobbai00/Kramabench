      },
      {
        "operatorID": "trend_analysis",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(trend_comparison):\n    df = trend_comparison.copy()\n    \n    # Filter to only months with valid exceedance rate data (non-NaN)\n    df_valid = df[df['Avg_Exceedance_Rate'].notna()].copy()\n    \n    # Sort by month to see the trend\n    df_valid = df_valid.sort_values('Month')\n    \n    # Calculate whether they trend together by comparing direction changes\n    exceedance = df_valid['Avg_Exceedance_Rate'].values\n    rainfall = df_valid['Avg_Rainfall'].values\n    \n    # Calculate month-to-month changes for both\n    exceedance_changes = [(exceedance[i+1] - exceedance[i]) for i in range(len(exceedance)-1)]\n    rainfall_changes = [(rainfall[i+1] - rainfall[i]) for i in range(len(rainfall)-1)]\n    \n    # Check if changes have the same sign (both positive or both negative)\n    same_direction = 0\n    for exc_change, rain_change in zip(exceedance_changes, rainfall_changes):\n        if (exc_change > 0 and rain_change > 0) or (exc_change < 0 and rain_change < 0):\n            same_direction += 1\n    \n    total_changes = len(exceedance_changes)\n    trend_correlation = same_direction / total_changes if total_changes > 0 else 0\n    \n    # Create result dataframe with analysis\n    result = pd.DataFrame({\n        'Month': df_valid['Month'].values,\n        'Exceedance_Rate': df_valid['Avg_Exceedance_Rate'].values,\n        'Rainfall': df_valid['Avg_Rainfall'].values\n    })\n    \n    return result\n"
        },
        "inputPorts": [
