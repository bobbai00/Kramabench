        "customDisplayName": "Analyze trend alignment between exceedance rate and rainfall for months with valid data",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "trend_verification",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(trend_analysis) -> pd.DataFrame:\n    df = trend_analysis.copy()\n    \n    # Calculate month-to-month changes for both metrics\n    df['exceedance_change'] = df['Exceedance_Rate'].diff()\n    df['rainfall_change'] = df['Rainfall'].diff()\n    \n    # Determine direction of change (1 for increase, -1 for decrease, 0 for no change/equal)\n    df['exceedance_direction'] = df['exceedance_change'].apply(lambda x: 1 if x > 0 else (-1 if x < 0 else 0))\n    df['rainfall_direction'] = df['rainfall_change'].apply(lambda x: 1 if x > 0 else (-1 if x < 0 else 0))\n    \n    # Check if trends match (same direction)\n    df['trends_match'] = df['exceedance_direction'] == df['rainfall_direction']\n    \n    # Count matching and non-matching month-to-month transitions\n    valid_transitions = df[df['exceedance_direction'] != 0].copy()\n    \n    if len(valid_transitions) > 0:\n        matches = valid_transitions['trends_match'].sum()\n        total = len(valid_transitions)\n        match_rate = matches / total\n    else:\n        match_rate = 0\n    \n    result = pd.DataFrame({\n        'Total_Valid_Transitions': [total if len(valid_transitions) > 0 else 0],\n        'Matching_Transitions': [matches if len(valid_transitions) > 0 else 0],\n        'Match_Rate': [match_rate],\n        'Trends_Follow_Same_Pattern': [match_rate >= 0.5]\n    })\n    \n    return result\n"
        },
