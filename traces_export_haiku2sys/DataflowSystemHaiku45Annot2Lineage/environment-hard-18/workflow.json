      },
      {
        "operatorID": "rainfall_imputed",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(rainfall_clean):\n    df = rainfall_clean.copy()\n    \n    for month in range(1, 13):\n        month_data = df[df['Month'] == month]['Rainfall']\n        median_val = month_data.median()\n        df.loc[(df['Month'] == month) & (df['Rainfall'].isna()), 'Rainfall'] = median_val\n    \n    return df\n"
        },
