      },
      {
        "operatorID": "trend_comparison",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(fresh_water_violations, rainfall_monthly_avg):\n    data_2020_2023 = fresh_water_violations[fresh_water_violations['Year'].between(2020, 2023)]\n    \n    monthly_exceedance = data_2020_2023.groupby('Month')['Exceedance_Rate'].mean().reset_index()\n    monthly_exceedance.columns = ['Month', 'Avg_Exceedance_Rate']\n    \n    merged = pd.merge(monthly_exceedance, rainfall_monthly_avg, on='Month', how='outer')\n    merged = merged.sort_values('Month')\n    \n    return merged\n"
        },
