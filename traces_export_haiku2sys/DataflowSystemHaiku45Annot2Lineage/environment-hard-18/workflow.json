      {
        "operatorID": "rainfall_clean",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(rainfall_combined):\n    df = rainfall_combined.copy()\n    df['Year'] = pd.to_numeric(df['Year'], errors='coerce')\n    \n    months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n    month_nums = list(range(1, 13))\n    \n    rows = []\n    for year in df['Year'].dropna().unique():\n        year_data = df[df['Year'] == year].iloc[0]\n        for month_name, month_num in zip(months, month_nums):\n            val = year_data[month_name]\n            if pd.isna(val) or val == 'M':\n                val_numeric = None\n            else:\n                try:\n                    val_numeric = float(val)\n                except:\n                    val_numeric = None\n            rows.append({'Year': int(year), 'Month': month_num, 'Rainfall': val_numeric})\n    \n    result = pd.DataFrame(rows)\n    return result\n"
        },
        "inputPorts": [
          {
