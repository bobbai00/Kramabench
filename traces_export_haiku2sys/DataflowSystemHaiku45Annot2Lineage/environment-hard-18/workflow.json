          "code": "\ndef process(rainfall_imputed):\n    data_2020_2023 = rainfall_imputed[rainfall_imputed['Year'].between(2020, 2023)]\n    \n    monthly_avg = data_2020_2023.groupby('Month')['Rainfall'].mean().reset_index()\n    monthly_avg.columns = ['Month', 'Avg_Rainfall']\n    \n    return monthly_avg\n"
