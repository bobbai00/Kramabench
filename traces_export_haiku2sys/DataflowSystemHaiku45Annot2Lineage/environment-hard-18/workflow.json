        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(water_2020, water_2021, water_2022, water_2023):\n    dfs = [water_2020, water_2021, water_2022, water_2023]\n    water_all = pd.concat(dfs, ignore_index=True)\n    \n    fresh_water = water_all[water_all['Beach Type Description'] == 'Fresh'].copy()\n    fresh_water['Sample Date'] = pd.to_datetime(fresh_water['Sample Date'])\n    fresh_water['Month'] = fresh_water['Sample Date'].dt.month\n    \n    violation_map = {'Yes': 1, 'YES': 1, 'No': 0, 'NO': 0}\n    fresh_water['Violation_Binary'] = fresh_water['Violation'].map(violation_map)\n    \n    monthly_stats = fresh_water.groupby(['Year', 'Month']).agg(\n        Total_Samples=('Violation_Binary', 'count'),\n        Violations=('Violation_Binary', 'sum')\n    ).reset_index()\n    \n    monthly_stats['Exceedance_Rate'] = monthly_stats['Violations'] / monthly_stats['Total_Samples']\n    \n    return monthly_stats[['Year', 'Month', 'Exceedance_Rate']]\n"
        },
