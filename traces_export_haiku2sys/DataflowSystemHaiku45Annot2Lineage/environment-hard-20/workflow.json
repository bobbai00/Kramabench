        "operatorProperties": {
          "code": "\ndef process(load_beach_testing, identify_least_rainfall_city) -> pd.DataFrame:\n    beaches = load_beach_testing\n    rainfall = identify_least_rainfall_city\n    \n    target_city = rainfall['city'].iloc[0].lower()\n    communities = beaches['Community'].unique()\n    \n    matching = [c for c in communities if c.lower() == target_city]\n    partial_match = [c for c in communities if target_city in c.lower()]\n    \n    result = pd.DataFrame({\n        'target_city': [target_city],\n        'exact_match_found': [len(matching) > 0],\n        'exact_matches': [str(matching)],\n        'partial_matches': [str(partial_match)],\n        'sample_communities': [', '.join(sorted(communities)[:10])]\n    })\n    return result\n"
