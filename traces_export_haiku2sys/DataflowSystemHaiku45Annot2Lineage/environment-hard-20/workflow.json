        "operatorID": "most_polluted_beaches",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(beaches_in_least_rainfall_city) -> pd.DataFrame:\n    df = beaches_in_least_rainfall_city.copy()\n    \n    pollution_score = df.groupby('Beach Name').agg({\n        'Violation': lambda x: (x == 'yes').sum(),\n        'Indicator Level': 'mean'\n    }).reset_index()\n    \n    pollution_score['pollution_rank'] = (\n        pollution_score['Violation'] * 100 + pollution_score['Indicator Level']\n    )\n    \n    top_3 = pollution_score.nlargest(3, 'pollution_rank')[['Beach Name', 'Violation', 'Indicator Level', 'pollution_rank']]\n    return top_3"
        },
