        "operatorProperties": {
          "code": "\ndef process(load_precipitation_data) -> pd.DataFrame:\n    df = load_precipitation_data.copy()\n    \n    # Convert columns to numeric, handling any non-numeric values\n    df['Jun'] = pd.to_numeric(df['Jun'], errors='coerce')\n    df['Jul'] = pd.to_numeric(df['Jul'], errors='coerce')\n    df['Aug'] = pd.to_numeric(df['Aug'], errors='coerce')\n    df['Year'] = pd.to_numeric(df['Year'], errors='coerce')\n    \n    # Filter for year 2015 only\n    df_2015 = df[df['Year'] == 2015].copy()\n    \n    # Calculate summer rainfall\n    df_2015['summer_rainfall'] = df_2015['Jun'] + df_2015['Jul'] + df_2015['Aug']\n    \n    return df_2015[['Year', 'Jun', 'Jul', 'Aug', 'summer_rainfall']]\n"
        },
