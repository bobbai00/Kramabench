        "operatorID": "calculate_fraud_percentage",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(extract_2024_data) -> pd.DataFrame:\n    row = extract_2024_data.iloc[0]\n    fraud = int(row['Fraud'].replace(',', ''))\n    identity_theft = int(row['Identity_Theft'].replace(',', ''))\n    other = int(row['Other'].replace(',', ''))\n    total = fraud + identity_theft + other\n    fraud_percentage = round((fraud / total) * 100)\n    return pd.DataFrame({'Fraud_Percentage': [fraud_percentage]})"
