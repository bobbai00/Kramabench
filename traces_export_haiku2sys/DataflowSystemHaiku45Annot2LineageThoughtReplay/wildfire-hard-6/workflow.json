      {
        "operatorID": "nifc_cleaned",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(nifc_wildfires) -> pd.DataFrame:\n    df = nifc_wildfires.copy()\n    df['Year'] = df['Year'].astype(int)\n    df['nifc_fires'] = df['Fires'].str.replace(',', '').astype(int)\n    df['nifc_acres'] = df['Acres'].str.replace(',', '').str.lstrip('*').astype(int)\n    return df[['Year', 'nifc_fires', 'nifc_acres']]"
        },
