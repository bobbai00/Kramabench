        "operatorProperties": {
          "code": "def process(nifc_cleaned, noaa_by_year) -> pd.DataFrame:\n    merged = nifc_cleaned.merge(noaa_by_year, on='Year', how='inner')\n    merged['fires_diff'] = merged['noaa_fires'] - merged['nifc_fires']\n    merged['acres_diff'] = merged['noaa_acres'] - merged['nifc_acres']\n    return merged"
