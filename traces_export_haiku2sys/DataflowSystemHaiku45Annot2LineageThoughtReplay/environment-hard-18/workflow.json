        "operatorProperties": {
          "code": "\ndef process(filter_precip_2020_2023):\n    df = filter_precip_2020_2023.copy()\n    month_cols = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n    month_map = {m: i+1 for i, m in enumerate(month_cols)}\n    \n    melted = df[['Year'] + month_cols].melt(id_vars=['Year'], var_name='Month_Name', value_name='Precipitation')\n    melted['Month'] = melted['Month_Name'].map(month_map)\n    melted = melted[['Year', 'Month', 'Precipitation']].dropna()\n    melted['Precipitation'] = pd.to_numeric(melted['Precipitation'], errors='coerce')\n    melted = melted.dropna()\n    \n    return melted.sort_values(['Year', 'Month']).reset_index(drop=True)\n"
