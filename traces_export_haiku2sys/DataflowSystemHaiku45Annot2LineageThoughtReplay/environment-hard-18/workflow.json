        "operatorProperties": {
          "code": "\ndef process(normalize_violations):\n    df = normalize_violations.copy()\n    df['Sample Date'] = pd.to_datetime(df['Sample Date'])\n    df['Year'] = df['Sample Date'].dt.year\n    df['Month'] = df['Sample Date'].dt.month\n    \n    fresh_df = df[df['Beach Type Description'] == 'Fresh']\n    \n    monthly_exceedance = fresh_df.groupby(['Year', 'Month']).apply(\n        lambda g: (g['Violation'] == 'YES').sum() / len(g)\n    ).reset_index()\n    monthly_exceedance.columns = ['Year', 'Month', 'Exceedance_Rate']\n    \n    return monthly_exceedance.sort_values(['Year', 'Month']).reset_index(drop=True)\n"
