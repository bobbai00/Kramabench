        "operatorProperties": {
          "code": "\ndef process(merge_exceedance_precip):\n    df = merge_exceedance_precip.copy()\n    \n    yearly_exceedance = df.groupby('Year')['Exceedance_Rate'].mean().reset_index()\n    yearly_exceedance.columns = ['Year', 'Avg_Exceedance_Rate']\n    \n    yearly_precip = df.groupby('Year')['Precipitation'].sum().reset_index()\n    yearly_precip.columns = ['Year', 'Total_Precipitation']\n    \n    yearly = yearly_exceedance.merge(yearly_precip, on='Year')\n    return yearly.sort_values('Year').reset_index(drop=True)\n"
