      {
        "operatorID": "check_trend_agreement",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(calculate_yearly_trends):\n    df = calculate_yearly_trends.copy()\n    \n    exceedance_values = df['Avg_Exceedance_Rate'].values\n    precip_values = df['Total_Precipitation'].values\n    \n    exceedance_changes = [1 if exceedance_values[i+1] > exceedance_values[i] else (-1 if exceedance_values[i+1] < exceedance_values[i] else 0) \n                          for i in range(len(exceedance_values)-1)]\n    precip_changes = [1 if precip_values[i+1] > precip_values[i] else (-1 if precip_values[i+1] < precip_values[i] else 0) \n                      for i in range(len(precip_values)-1)]\n    \n    trends_match = all(ec == pc for ec, pc in zip(exceedance_changes, precip_changes))\n    \n    result = pd.DataFrame({\n        'Year': df['Year'].values,\n        'Avg_Exceedance_Rate': df['Avg_Exceedance_Rate'].values,\n        'Total_Precipitation': df['Total_Precipitation'].values,\n        'Trends_Match': [trends_match] * len(df)\n    })\n    \n    return result\n"
