        "operatorProperties": {
          "code": "\ndef process(load_peptides) -> pd.DataFrame:\n    target_peptide = 'HPKPEVLGSSADGALLVSLDGLR'\n    df = load_peptides.copy()\n    \n    # Find the column with peptide sequences (likely first column)\n    peptide_col = df.columns[0]\n    samples_col = df.columns[-1] if len(df.columns) > 1 else None\n    \n    # Filter for the target peptide\n    mask = df[peptide_col].astype(str).str.contains(target_peptide, na=False, case=True)\n    result = df[mask]\n    \n    return result\n"
