        "operatorProperties": {
          "code": "\ndef process(load_peptides) -> pd.DataFrame:\n    df = load_peptides.copy()\n    target = 'HPKPEVLGSSADGALLVSLDGLR'\n    \n    # Check if target peptide exists in any form\n    matching = df[df['Peptide'].str.contains(target, case=True, na=False)]\n    if len(matching) == 0:\n        # Check with whitespace stripped\n        df['Peptide_clean'] = df['Peptide'].str.strip()\n        matching = df[df['Peptide_clean'] == target]\n    \n    # Also show a few sample peptides to understand the format\n    return pd.DataFrame({\n        'matching_rows': [len(matching)],\n        'sample_peptides': ['; '.join(df['Peptide'].dropna().head(5).tolist())]\n    })\n"
