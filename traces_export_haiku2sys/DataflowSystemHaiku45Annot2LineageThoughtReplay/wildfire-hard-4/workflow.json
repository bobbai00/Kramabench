        "operatorProperties": {
          "code": "\ndef process(suppression_costs) -> pd.DataFrame:\n    df = suppression_costs.copy()\n    df['Year'] = pd.to_numeric(df['Year'], errors='coerce')\n    df['Total_numeric'] = df['Total'].str.replace('$', '').str.replace(',', '').astype(float)\n    df['Acres_numeric'] = df['Acres'].str.replace(',', '').astype(float)\n    return df[['Year', 'Acres_numeric', 'Total_numeric']]\n"
        },
