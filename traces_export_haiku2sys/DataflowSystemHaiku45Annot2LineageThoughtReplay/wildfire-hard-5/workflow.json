        "operatorProperties": {
          "code": "\ndef process(nifc_clean, noaa_clean) -> pd.DataFrame:\n    nifc_avg = nifc_clean['Fires'].mean()\n    noaa_avg = noaa_clean['Fires'].mean()\n    difference = round(noaa_avg - nifc_avg)\n    \n    return pd.DataFrame({\n        'NIFC_Avg': [nifc_avg],\n        'NOAA_Avg': [noaa_avg],\n        'Difference': [difference]\n    })\n"
