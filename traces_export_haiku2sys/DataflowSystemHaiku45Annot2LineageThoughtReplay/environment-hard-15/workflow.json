        "operatorID": "beach_year_stats",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(normalize_violations) -> pd.DataFrame:\n    df = normalize_violations.copy()\n    \n    # Calculate exceedance rate per beach per year\n    stats = df.groupby(['Beach Name', 'Year']).agg(\n        total_tests=('Violation', 'size'),\n        violations=('Violation', lambda x: (x == 'YES').sum())\n    ).reset_index()\n    \n    stats['exceedance_rate'] = stats['violations'] / stats['total_tests']\n    \n    return stats"
        },
        "inputPorts": [
