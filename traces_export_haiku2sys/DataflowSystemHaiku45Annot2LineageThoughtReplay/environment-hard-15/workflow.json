        "operatorProperties": {
          "code": "def process(beach_year_stats) -> pd.DataFrame:\n    years_per_beach = beach_year_stats.groupby('Beach Name')['Year'].nunique()\n    beaches_with_all_years = years_per_beach[years_per_beach == 4].index.tolist()\n    return beach_year_stats[beach_year_stats['Beach Name'].isin(beaches_with_all_years)]"
