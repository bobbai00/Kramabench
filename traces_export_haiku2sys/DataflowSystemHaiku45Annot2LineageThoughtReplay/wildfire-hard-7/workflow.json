        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(total_by_area_year, historical_stats) -> pd.DataFrame:\n    # Flatten the multi-level columns from historical_stats\n    historical_stats.columns = ['Area', 'mean_acres', 'std_acres']\n    \n    # Merge\n    df = total_by_area_year.merge(historical_stats, on='Area')\n    return df\n"
        },
