      {
        "operatorID": "clean_data",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(combine_data) -> pd.DataFrame:\n    df = combine_data.copy()\n    \n    # Get geographic areas (all columns except Year, Total, and source)\n    geo_cols = [col for col in df.columns if col not in ['Year', 'Total', 'source']]\n    \n    # Clean numeric columns - remove commas and convert to numeric\n    for col in geo_cols:\n        df[col] = df[col].astype(str).str.replace(',', '').replace('N/A', 'nan').replace('NaN', 'nan')\n        df[col] = pd.to_numeric(df[col], errors='coerce')\n    \n    # Clean Total column\n    df['Total'] = df['Total'].astype(str).str.replace(',', '').replace('N/A', 'nan').replace('NaN', 'nan')\n    df['Total'] = pd.to_numeric(df['Total'], errors='coerce')\n    \n    return df[['Year', 'source'] + geo_cols + ['Total']]\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
            "isDynamicPort": false,
            "dependencies": []
          }
        ],
        "outputPorts": [
          {
            "portID": "output-0",
            "displayName": "",
            "disallowMultiInputs": false,
            "isDynamicPort": false
          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Clean numeric columns by removing commas and converting to numeric type; handle N/A values",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "clean_lightning",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(lightning_data) -> pd.DataFrame:\n    df = lightning_data.copy()\n    \n    # Drop Total column\n    df = df.drop('Total', axis=1)\n    \n    # Melt all area columns into long format\n    area_cols = [col for col in df.columns if col != 'Year']\n    df = df.melt(id_vars=['Year'], var_name='Area', value_name='Acres')\n    \n    # Convert Acres to numeric, removing commas and handling NaN\n    df['Acres'] = df['Acres'].astype(str).str.replace(',', '')\n    df['Acres'] = pd.to_numeric(df['Acres'], errors='coerce')\n    \n    # Remove rows with NaN acres\n    df = df.dropna(subset=['Acres'])\n    \n    # Add source column\n    df['Source'] = 'lightning'\n    \n    return df\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
            "disallowMultiInputs": false,
