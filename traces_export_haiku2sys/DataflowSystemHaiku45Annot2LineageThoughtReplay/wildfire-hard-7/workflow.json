      },
      {
        "operatorID": "verify_top_anomalies",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(calculate_anomaly):\n    df = calculate_anomaly.copy()\n    df['abs_z_score'] = df['z_score'].abs()\n    top_10 = df.nlargest(10, 'abs_z_score')[['Area', 'Year', 'z_score', 'abs_z_score', 'Acres', 'mean_acres']]\n    return top_10\n"
        },
