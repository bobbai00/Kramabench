        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Calculate Z-score for each area-year combination to measure anomaly relative to historical average",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "find_max_anomaly",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(calculate_anomaly) -> pd.DataFrame:\n    df = calculate_anomaly.dropna(subset=['z_score'])\n    \n    # Find the row with maximum absolute Z-score\n    df['abs_z_score'] = df['z_score'].abs()\n    max_idx = df['abs_z_score'].idxmax()\n    \n    result = df.loc[[max_idx], ['Area', 'Year', 'z_score', 'Acres', 'mean_acres']]\n    return result\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
