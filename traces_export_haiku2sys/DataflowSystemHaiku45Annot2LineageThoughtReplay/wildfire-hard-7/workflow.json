            "isDynamicPort": false
          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Clean and unpivot lightning-caused acres data: remove Total column, convert wide format to long, clean comma-separated values, convert to numeric, and add source label",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "clean_human",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(human_data) -> pd.DataFrame:\n    df = human_data.copy()\n    \n    # Drop Total column\n    df = df.drop('Total', axis=1)\n    \n    # Melt all area columns into long format\n    area_cols = [col for col in df.columns if col != 'Year']\n    df = df.melt(id_vars=['Year'], var_name='Area', value_name='Acres')\n    \n    # Convert Acres to numeric, removing commas and handling NaN\n    df['Acres'] = df['Acres'].astype(str).str.replace(',', '')\n    df['Acres'] = pd.to_numeric(df['Acres'], errors='coerce')\n    \n    # Remove rows with NaN acres\n    df = df.dropna(subset=['Acres'])\n    \n    # Add source column\n    df['Source'] = 'human'\n    \n    return df\n"
        },
