      {
        "operatorID": "calculate_anomaly",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(merge_with_historical) -> pd.DataFrame:\n    df = merge_with_historical.copy()\n    \n    # Calculate Z-score\n    df['z_score'] = (df['Acres'] - df['mean_acres']) / df['std_acres']\n    \n    # Replace inf values with NaN\n    df['z_score'] = df['z_score'].replace([float('inf'), float('-inf')], float('nan'))\n    \n    return df\n"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "input_0",
