        "operatorID": "average_rank_greece",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(greece_cities) -> pd.DataFrame:\n    ranks = []\n    for rank_str in greece_cities['Barrington Atlas Rank']:\n        if 'or' in str(rank_str):\n            parts = str(rank_str).split(' or ')\n            avg = (float(parts[0]) + float(parts[1])) / 2\n            ranks.append(avg)\n        else:\n            ranks.append(float(rank_str))\n    \n    avg_rank = sum(ranks) / len(ranks)\n    return pd.DataFrame({'average_rank': [round(avg_rank, 4)]})\n"
