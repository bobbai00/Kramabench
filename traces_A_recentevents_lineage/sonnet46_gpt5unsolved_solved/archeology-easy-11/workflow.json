        "operatorID": "avg_lat_capitals",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(worldcities) -> pd.DataFrame:\n    # Filter to primary capitals only\n    capitals = worldcities[worldcities['capital'] == 'primary'].copy()\n    \n    # For countries with multiple primary capitals, keep the one with the largest population\n    # Sort by population descending, then take first per country\n    capitals_sorted = capitals.sort_values('population', ascending=False)\n    capitals_top = capitals_sorted.groupby('country', as_index=False).first()\n    \n    # Compute average latitude\n    avg_lat = capitals_top['lat'].mean()\n    \n    return pd.DataFrame({'avg_latitude': [round(avg_lat, 4)]})\n"
        },
        "inputPorts": [
