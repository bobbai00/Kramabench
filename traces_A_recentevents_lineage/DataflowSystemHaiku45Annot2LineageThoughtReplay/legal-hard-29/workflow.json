        "operatorID": "load_fraud_data",
        "operatorType": "DataLoading",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef load() -> pd.DataFrame:\n    import glob\n    all_data = []\n    files = glob.glob('data/legal/input/csn-data-book-2024-csv/CSVs/State MSA Fraud and Other data/*.csv')\n    \n    for filepath in files:\n        try:\n            df = pd.read_csv(filepath, skiprows=2)\n            df = df.dropna(subset=['Metropolitan Area'])\n            df = df[df['Metropolitan Area'].str.strip() != '']\n            df = df[~df['Metropolitan Area'].str.contains('Metropolitan Areas are defined|Source:', na=False)]\n            if len(df) > 0:\n                state = filepath.split('/')[-1].replace('.csv', '')\n                df['State'] = state\n                all_data.append(df)\n        except Exception as e:\n            continue\n    \n    if all_data:\n        result = pd.concat(all_data, ignore_index=True)\n        return result\n    else:\n        return pd.DataFrame()\n"
        },
        "inputPorts": [],
        "outputPorts": [
