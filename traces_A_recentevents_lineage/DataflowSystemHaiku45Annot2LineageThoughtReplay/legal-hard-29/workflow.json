          "code": "def process(clean_reports, state_totals) -> pd.DataFrame:\n    merged = clean_reports.merge(state_totals, on='State', how='left')\n    merged['Percentage'] = (merged['# of Reports'] / merged['Total_Reports_State']) * 100\n    return merged[['Metropolitan Area', 'State', '# of Reports', 'Total_Reports_State', 'Percentage']]\n"
