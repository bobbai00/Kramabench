      {
        "operatorID": "extract_summer_2020",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(boston_data, chatham_data, amherst_data, ashburnham_data):\n    results = []\n    \n    # Extract 2020 summer data for each region\n    for region_name, df in [('Boston', boston_data), ('Chatham', chatham_data), \n                             ('Amherst', amherst_data), ('Ashburnham', ashburnham_data)]:\n        row_2020 = df[df['Year'] == '2020']\n        if not row_2020.empty:\n            jun = pd.to_numeric(row_2020['Jun'].values[0], errors='coerce')\n            jul = pd.to_numeric(row_2020['Jul'].values[0], errors='coerce')\n            aug = pd.to_numeric(row_2020['Aug'].values[0], errors='coerce')\n            total = sum([x for x in [jun, jul, aug] if pd.notna(x)])\n            results.append({\n                'Region': region_name,\n                'June_2020': jun,\n                'July_2020': jul,\n                'August_2020': aug,\n                'Total_Summer_2020': total\n            })\n    \n    return pd.DataFrame(results)\n"
        },
