        "operatorProperties": {
          "code": "def process(cause_by_region) -> pd.DataFrame:\n    from scipy.stats import chi2_contingency\n    \n    contingency_table = cause_by_region.set_index('region')[['H', 'L', 'N']].values\n    chi2, p_value, dof, expected = chi2_contingency(contingency_table)\n    \n    result = pd.DataFrame({\n        'chi_square_statistic': [chi2],\n        'p_value': [p_value]\n    })\n    \n    return result\n"
