        "operatorProperties": {
          "code": "\ndef process(wollaston_beach):\n    # Check violation value counts to understand the data\n    violation_counts = wollaston_beach['Violation'].value_counts()\n    \n    # Count tests that met standards (Violation = No or NO, i.e., no violation)\n    met_standards = wollaston_beach[wollaston_beach['Violation'].isin(['No', 'NO'])].shape[0]\n    \n    # Count tests that did NOT meet standards (Violation = Yes or YES)\n    not_met = wollaston_beach[wollaston_beach['Violation'].isin(['Yes', 'YES'])].shape[0]\n    \n    total = wollaston_beach.shape[0]\n    \n    # Calculate percentage\n    percentage_exact = (met_standards / total) * 100\n    percentage_rounded = round(percentage_exact)\n    \n    return pd.DataFrame({\n        'met_standards': [met_standards],\n        'not_met_standards': [not_met],\n        'total_tests': [total],\n        'exact_percentage': [percentage_exact],\n        'rounded_percentage': [percentage_rounded]\n    })\n"
        },
