      {
        "operatorID": "prepare_correlation_data",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(extract_plk1, extract_chek2_s163, filter_tumor_samples) -> pd.DataFrame:\n    plk1 = extract_plk1.copy()\n    chek2 = extract_chek2_s163.copy()\n    tumor_ids = filter_tumor_samples.copy()\n    \n    plk1_values = plk1.iloc[0, 1:].to_dict()\n    chek2_values = chek2.iloc[0, 1:].to_dict()\n    \n    sample_list = list(plk1_values.keys())\n    \n    data = {\n        'sample_id': sample_list,\n        'PLK1': [plk1_values.get(s) for s in sample_list],\n        'CHEK2_S163': [chek2_values.get(s) for s in sample_list]\n    }\n    \n    df = pd.DataFrame(data)\n    df = df[df['sample_id'].isin(tumor_ids['idx'].values)]\n    df = df.dropna()\n    \n    return df"
        },
