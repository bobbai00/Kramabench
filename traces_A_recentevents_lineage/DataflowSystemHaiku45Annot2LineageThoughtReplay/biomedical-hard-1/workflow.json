      },
      {
        "operatorID": "spearman_correlation",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(prepare_correlation_data):\n    from scipy.stats import spearmanr\n    \n    plk1 = prepare_correlation_data['PLK1']\n    chek2_s163 = prepare_correlation_data['CHEK2_S163']\n    \n    corr, pval = spearmanr(plk1, chek2_s163)\n    \n    result = pd.DataFrame({\n        'correlation': [round(corr, 4)],\n        'p_value': [pval],\n        'n_samples': [len(plk1)]\n    })\n    \n    return result\n"
        },
