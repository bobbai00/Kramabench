      },
      {
        "operatorID": "filter_new_england_metros",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(clean_identity_theft_data, load_new_england_states) -> pd.DataFrame:\n    ne_states = set(load_new_england_states['Name'].values)\n    state_abbrev = {'Connecticut': 'CT', 'Maine': 'ME', 'Massachusetts': 'MA', \n                    'New Hampshire': 'NH', 'Rhode Island': 'RI', 'Vermont': 'VT'}\n    ne_abbrev = set(state_abbrev[state] for state in ne_states)\n    \n    def has_ne_state(metro_name):\n        for abbrev in ne_abbrev:\n            if f', {abbrev}' in metro_name or f', {abbrev} ' in metro_name:\n                return True\n        return False\n    \n    filtered = clean_identity_theft_data[clean_identity_theft_data['Metropolitan_Area'].apply(has_ne_state)]\n    return filtered.sort_values('Reports', ascending=False).reset_index(drop=True)\n"
