        "customDisplayName": "Load all Identity Theft data CSV files from State MSA Identity Theft data folder using header=1 to skip the source rows, concatenate all files, and drop empty rows.",
        "dynamicInputPorts": false,
        "dynamicOutputPorts": false
      },
      {
        "operatorID": "clean_identity_theft_data",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_identity_theft_data) -> pd.DataFrame:\n    df = load_identity_theft_data.copy()\n    df.columns = ['Metropolitan_Area', 'Reports']\n    df = df[df['Metropolitan_Area'] != 'Metropolitan Area'].copy()\n    df = df.dropna(subset=['Reports'])\n    df = df[~df['Reports'].astype(str).str.contains('Metropolitan Areas are defined|Source:', na=False)]\n    df['Reports'] = df['Reports'].astype(str).str.replace(',', '').astype(int)\n    return df.drop_duplicates()\n"
        },
