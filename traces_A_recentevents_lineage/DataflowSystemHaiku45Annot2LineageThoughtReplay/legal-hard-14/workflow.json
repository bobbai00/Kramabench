          "code": "\ndef load() -> pd.DataFrame:\n    import glob\n    files = glob.glob('data/legal/input/csn-data-book-2024-csv/CSVs/State MSA Identity Theft data/*.csv')\n    dfs = []\n    for file in files:\n        df = pd.read_csv(file, header=1)\n        dfs.append(df)\n    result = pd.concat(dfs, ignore_index=True)\n    return result.dropna(how='all')\n"
        },
