      {
        "operatorID": "bacterial_exceedance_rates",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(marine_with_ej) -> pd.DataFrame:\n    results = []\n    for ej_cat in ['High (>50%)', 'Low (<25%)']:\n        subset = marine_with_ej[marine_with_ej['EJ_Category'] == ej_cat]\n        total_samples = len(subset)\n        violations = (subset['Violation'] == 'Yes').sum()\n        exceedance_rate = (violations / total_samples * 100) if total_samples > 0 else 0\n        results.append({\n            'EJ_Category': ej_cat,\n            'Total_Samples': total_samples,\n            'Violations': violations,\n            'Exceedance_Rate': exceedance_rate\n        })\n    return pd.DataFrame(results)"
        },
