      {
        "operatorID": "ej_high_low_communities",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(ej_populations) -> pd.DataFrame:\n    high_ej = ej_populations[ej_populations['Percent of population in EJ BGs'] > 50]['Municipality'].tolist()\n    low_ej = ej_populations[ej_populations['Percent of population in EJ BGs'] < 25]['Municipality'].tolist()\n    \n    df = pd.DataFrame({\n        'Municipality': high_ej + low_ej,\n        'EJ_Category': ['High (>50%)'] * len(high_ej) + ['Low (<25%)'] * len(low_ej)\n    })\n    return df\n"
