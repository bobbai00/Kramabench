        "operatorProperties": {
          "code": "def process(bacterial_exceedance_rates) -> pd.DataFrame:\n    high_ej = bacterial_exceedance_rates[bacterial_exceedance_rates['EJ_Category'] == 'High (>50%)']['Exceedance_Rate'].values[0]\n    low_ej = bacterial_exceedance_rates[bacterial_exceedance_rates['EJ_Category'] == 'Low (<25%)']['Exceedance_Rate'].values[0]\n    difference = round(high_ej - low_ej, 2)\n    return pd.DataFrame({'Difference': [difference]})"
        },
