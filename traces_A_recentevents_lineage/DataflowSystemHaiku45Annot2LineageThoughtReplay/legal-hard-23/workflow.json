      {
        "operatorID": "fraud_reports_clean",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(fraud_reports) -> pd.DataFrame:\n    df = fraud_reports.copy()\n    df.columns = df.iloc[0]\n    df = df.iloc[1:].reset_index(drop=True)\n    df = df.dropna(how='all')\n    df = df[df['State'].notna() & (df['State'] != '')]\n    df['Reports per 100K Population'] = pd.to_numeric(df['Reports per 100K Population'].astype(str).str.replace(',', ''), errors='coerce')\n    df['# of Reports'] = pd.to_numeric(df['# of Reports'].astype(str).str.replace(',', ''), errors='coerce')\n    df = df.dropna(subset=['Reports per 100K Population'])\n    df['Report Type'] = 'Fraud and Other'\n    return df[['State', 'Reports per 100K Population', '# of Reports', 'Report Type']]"
        },
