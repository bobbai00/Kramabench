        "operatorProperties": {
          "code": "def process(find_90_percent_wildfires, cumsum_threatened) -> pd.DataFrame:\n    # find_90_percent_wildfires has the single row with the wildfire that reaches 90%\n    # We need to count how many wildfires are in cumsum_threatened up to and including that one\n    \n    target_row = find_90_percent_wildfires.iloc[0]\n    target_incident = target_row['incident_number']\n    \n    # Find the position of this incident in the sorted list\n    position = cumsum_threatened[cumsum_threatened['incident_number'] == target_incident].index[0]\n    \n    # Count is position + 1 (since index is 0-based)\n    count = position + 1\n    \n    return pd.DataFrame({'wildfires_for_90_percent': [count]})"
