        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(chatham_beaches):\n    pollution_by_beach = chatham_beaches.groupby('Beach Name').agg({\n        'Indicator Level': ['mean', 'sum', 'count'],\n        'Violation': lambda x: (x == 'yes').sum()\n    }).reset_index()\n    \n    pollution_by_beach.columns = ['Beach Name', 'Avg_Indicator', 'Total_Indicator', 'Sample_Count', 'Violations']\n    pollution_by_beach['Pollution_Score'] = pollution_by_beach['Total_Indicator'] + (pollution_by_beach['Violations'] * 100)\n    pollution_by_beach = pollution_by_beach.sort_values('Pollution_Score', ascending=False)\n    \n    return pollution_by_beach\n"
