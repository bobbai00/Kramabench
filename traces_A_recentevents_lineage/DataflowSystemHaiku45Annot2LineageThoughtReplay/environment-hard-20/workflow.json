      {
        "operatorID": "summer_rainfall_2015",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(rainfall_amherst, rainfall_boston, rainfall_ashburnham, rainfall_chatham) -> pd.DataFrame:\n    cities = {\n        'Amherst': rainfall_amherst,\n        'Boston': rainfall_boston,\n        'Ashburnham': rainfall_ashburnham,\n        'Chatham': rainfall_chatham\n    }\n    \n    results = []\n    for city, df in cities.items():\n        row_2015 = df[df['Year'] == '2015']\n        if len(row_2015) > 0:\n            jun = pd.to_numeric(row_2015['Jun'].iloc[0], errors='coerce')\n            jul = pd.to_numeric(row_2015['Jul'].iloc[0], errors='coerce')\n            aug = pd.to_numeric(row_2015['Aug'].iloc[0], errors='coerce')\n            summer_total = sum([x for x in [jun, jul, aug] if pd.notna(x)])\n            results.append({'City': city, 'Summer_Rainfall': summer_total})\n    \n    return pd.DataFrame(results)\n"
        },
