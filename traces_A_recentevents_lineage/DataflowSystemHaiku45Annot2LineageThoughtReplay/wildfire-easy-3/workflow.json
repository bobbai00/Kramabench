      },
      {
        "operatorID": "spatial_intersect",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(load_nifc_areas, load_usa_states) -> pd.DataFrame:\n    import geopandas as gpd\n    from shapely.geometry import shape\n    \n    # Convert tables to GeoDataFrames\n    nifc_df = load_nifc_areas.copy()\n    usa_df = load_usa_states.copy()\n    \n    # Create GeoDataFrames from the geometry columns\n    nifc_gdf = gpd.GeoDataFrame(nifc_df, geometry='geometry', crs='EPSG:4326')\n    usa_gdf = gpd.GeoDataFrame(usa_df, geometry='geometry', crs='EPSG:4326')\n    \n    # Perform spatial intersection\n    intersections = gpd.sjoin(usa_gdf, nifc_gdf, how='left', predicate='intersects')\n    \n    # Get unique combinations of state (adm1_name) and NIFC area (GACCName)\n    result = intersections[['adm1_name', 'GACCName']].drop_duplicates()\n    result = result.dropna(subset=['adm1_name', 'GACCName'])\n    \n    return result"
        },
        "inputPorts": [
          {
            "portID": "input-0",
            "displayName": "Input 0",
            "disallowMultiInputs": true,
            "isDynamicPort": false
          },
          {
            "portID": "input-1",
            "displayName": "Input 1",
            "disallowMultiInputs": true,
