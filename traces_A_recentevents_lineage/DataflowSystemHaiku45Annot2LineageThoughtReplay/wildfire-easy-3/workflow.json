          "code": "def process(count_nifc_per_state):\n    max_count = count_nifc_per_state['nifc_count'].max()\n    result = count_nifc_per_state[count_nifc_per_state['nifc_count'] == max_count]\n    return result.sort_values('adm1_name')\n"
