          }
        ],
        "showAdvanced": false,
        "isDisabled": false,
        "customDisplayName": "Perform spatial intersection between USA state boundaries and NIFC Geographic Areas. Convert to GeoDataFrames, perform sjoin with 'intersects' predicate, extract unique state-NIFC area combinations.",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
      },
      {
        "operatorID": "count_nifc_per_state",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(spatial_intersect) -> pd.DataFrame:\n    return spatial_intersect.groupby('adm1_name')['GACCName'].nunique().reset_index().rename(columns={'GACCName': 'nifc_count'}).sort_values('nifc_count', ascending=False)\n"
        },
