        "operatorProperties": {
          "code": "def load() -> pd.DataFrame:\n    import glob\n    files = sorted(glob.glob('data/environment/input/water-body-testing-*.csv'))\n    dfs = []\n    for file in files:\n        df = pd.read_csv(file)\n        dfs.append(df)\n    return pd.concat(dfs, ignore_index=True)"
        },
