        "isDisabled": false,
        "customDisplayName": "Calculate bacterial exceedance rate by year for freshwater beaches. Normalizes Violation values to lowercase 'yes' for comparison, counts exceedances per year, and calculates exceedance_rate as percentage.",
        "dynamicInputPorts": true,
        "dynamicOutputPorts": true
