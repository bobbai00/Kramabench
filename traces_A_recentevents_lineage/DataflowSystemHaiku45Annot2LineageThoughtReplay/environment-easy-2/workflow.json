      {
        "operatorID": "exceedance_by_year",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(freshwater_samples) -> pd.DataFrame:\n    df = freshwater_samples.copy()\n    df['is_exceedance'] = df['Violation'].str.lower() == 'yes'\n    \n    yearly_stats = df.groupby('Year').agg(\n        total_samples=('is_exceedance', 'count'),\n        exceedances=('is_exceedance', 'sum')\n    ).reset_index()\n    \n    yearly_stats['exceedance_rate'] = (yearly_stats['exceedances'] / yearly_stats['total_samples'] * 100).round(2)\n    \n    return yearly_stats.sort_values('Year')\n"
        },
        "inputPorts": [
