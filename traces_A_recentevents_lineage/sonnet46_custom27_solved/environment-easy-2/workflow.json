        "operatorID": "freshwater_exceedance",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(all_data):\n    df = all_data[all_data['Beach Type Description'] == 'Fresh'].copy()\n    df['is_violation'] = df['Violation'].str.strip().str.lower() == 'yes'\n    yearly = df.groupby('Year').agg(\n        total=('is_violation', 'count'),\n        violations=('is_violation', 'sum')\n    ).reset_index()\n    yearly['exceedance_rate'] = yearly['violations'] / yearly['total']\n    avg_rate = round(yearly['exceedance_rate'].mean(), 2)\n    yearly['above_avg'] = yearly['exceedance_rate'] > avg_rate\n    yearly['avg_rate'] = avg_rate\n    return yearly.sort_values('Year')\n"
        },
