      {
        "operatorID": "noaa_annual",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(noaa_data) -> pd.DataFrame:\n    df = noaa_data.copy()\n    df['Year'] = (df['Date'] // 100).astype(int)\n    annual = df.groupby('Year')['Number of Fires'].sum().reset_index()\n    annual.columns = ['Year', 'NOAA_Fires']\n    return annual[annual['Year'] >= 2000]\n"
        },
