      {
        "operatorID": "avg_diff",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(noaa_annual, nifc_annual):\n    merged = noaa_annual.merge(nifc_annual, on='Year', how='inner')\n    merged['diff'] = merged['NOAA_Fires'] - merged['NIFC_Fires']\n    result = pd.DataFrame({\n        'avg_diff': [round(merged['diff'].mean())],\n        'years_compared': [len(merged)],\n        'mean_noaa': [merged['NOAA_Fires'].mean()],\n        'mean_nifc': [merged['NIFC_Fires'].mean()]\n    })\n    return result\n"
        },
