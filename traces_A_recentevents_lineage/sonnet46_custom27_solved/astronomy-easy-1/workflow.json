      {
        "operatorID": "compute_mae",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "\ndef process(inspect_0309, inspect_0311, inspect_0312, inspect_0313):\n    # Forecasted values from 0309 file: \"Predicted Ap 10 Mar-12 Mar 025-020-012\"\n    forecast_line = inspect_0309[inspect_0309['line'].str.startswith('Predicted Ap 10 Mar')]['line'].values[0]\n    parts = forecast_line.split()\n    preds = list(map(int, parts[-1].split('-')))\n    forecast_mar10, forecast_mar11, forecast_mar12 = preds[0], preds[1], preds[2]\n\n    # Actual values from subsequent observed lines\n    obs_mar10 = int(inspect_0311[inspect_0311['line'].str.startswith('Observed Ap 10 Mar')]['line'].values[0].split()[-1])\n    obs_mar11 = int(inspect_0312[inspect_0312['line'].str.startswith('Observed Ap 11 Mar')]['line'].values[0].split()[-1])\n    obs_mar12 = int(inspect_0313[inspect_0313['line'].str.startswith('Observed Ap 12 Mar')]['line'].values[0].split()[-1])\n\n    errors = [\n        abs(forecast_mar10 - obs_mar10),\n        abs(forecast_mar11 - obs_mar11),\n        abs(forecast_mar12 - obs_mar12),\n    ]\n    mae = sum(errors) / len(errors)\n\n    return pd.DataFrame({\n        'date': ['Mar 10', 'Mar 11', 'Mar 12'],\n        'forecast': [forecast_mar10, forecast_mar11, forecast_mar12],\n        'actual': [obs_mar10, obs_mar11, obs_mar12],\n        'abs_error': errors,\n        'MAE': [mae, mae, mae]\n    })\n"
        },
