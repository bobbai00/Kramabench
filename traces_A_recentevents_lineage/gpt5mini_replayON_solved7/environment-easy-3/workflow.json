        "operatorID": "compare_rates",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(wb2012, wb2013) -> pd.DataFrame:\n    # group by unique beach identifier: Community Code + Beach Name\n    g2012 = wb2012.groupby(['Community Code', 'Beach Name'], dropna=False).agg(total_2012=('Violation', 'size'), exceed_2012=('Violation', lambda s: (s == 'yes').sum())).reset_index()\n    g2012['rate_2012'] = g2012['exceed_2012'] / g2012['total_2012']\n    g2013 = wb2013.groupby(['Community Code', 'Beach Name'], dropna=False).agg(total_2013=('Violation', 'size'), exceed_2013=('Violation', lambda s: (s == 'yes').sum())).reset_index()\n    g2013['rate_2013'] = g2013['exceed_2013'] / g2013['total_2013']\n    merged = g2012.merge(g2013, on=['Community Code', 'Beach Name'], how='inner')\n    higher = merged[merged['rate_2013'] > merged['rate_2012']]\n    return pd.DataFrame({'higher_count': [int(len(higher))]})\n"
        },
