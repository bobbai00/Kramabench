      {
        "operatorID": "nearby_modern_cities",
        "operatorType": "DataProcessing",
        "operatorVersion": "N/A",
        "operatorProperties": {
          "code": "def process(roman_cities, world_cities) -> pd.DataFrame:\n    rc = roman_cities[['Primary Key','Longitude (X)','Latitude (Y)']].dropna()\n    wc = world_cities[['id','city','lat','lng','population']].dropna(subset=['lat','lng','population'])\n    wc = wc[wc['population'] > 100000]\n    wc['__k'] = 1\n    rc['__k'] = 1\n    df = pd.merge(wc, rc, on='__k').drop('__k', axis=1)\n    df['dist_deg'] = ((df['lat'] - df['Latitude (Y)'])**2 + (df['lng'] - df['Longitude (X)'])**2)**0.5\n    df = df[df['dist_deg'] <= 0.1]\n    result = pd.DataFrame({'modern_city_count': [df['id'].nunique()]})\n    return result"
        },
